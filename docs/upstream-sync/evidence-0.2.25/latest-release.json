nux_arm64.tar.gz"},{"url":"https://api.github.com/repos/Wei-Shaw/sub2api/releases/assets/785517835","id":785517835,"node_id":"RA_kwDOQqyBLs4u0g0L","name":"sub2api_0.2.25_windows_amd64.zip","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/zip","state":"uploaded","size":41098343,"digest":"sha256:431443d040e80ea8e75d0939f440ffd54981e4fce04edf3e94e23e4495d73f13","download_count":131,"created_at":"2026-11-24T03:21:03Z","updated_at":"2026-11-24T03:21:05Z","browser_download_url":"https://github.com/Wei-Shaw/sub2api/releases/download/v0.2.25/sub2api_0.2.25_windows_amd64.zip"}],"tarball_url":"https://api.github.com/repos/Wei-Shaw/sub2api/tarball/v0.2.25","zipball_url":"https://api.github.com/repos/Wei-Shaw/sub2api/zipball/v0.2.25","body":"> AI API Gateway Platform - 将 AI 订阅配额分发和管理\n\nAPI Key 账号的请求头覆写支持身份上报变量，可把本次请求的用户、密钥、分组等网关身份带给上游；账号名称与备注支持从上游分组一键或自动同步。\n\n## 新增功能\n\n- 请求头覆写身份上报变量：API Key 账号的覆写值可使用 {{user_id}} / {{api_key_id}} / {{group_id}} / {{request_id}}，转发时替换为本次请求的网关身份；编辑器新增变量面板、发送示例预览与行内错误提示\n- 错误详情新增「身份上报请求头」区块，展示该次请求实际上报给上游的身份头\n- 上游分组名称与备注同步：创建/编辑账号及账号列表可一键把上游分组名称、描述同步为账号名称与备注\n- 自动同步上游分组名称与备注：每个 API Key 账号可单独开启（默认关闭），随上游倍率探测一并更新\n- /v1/sub2api/billing 接口支持 include=group，返回 Key 所绑定分组的名称与描述\n\n## 优化改进\n\n- OpenAI 透传模式支持管理员配置的错误透传规则（透传上游错误体、自定义文案、跳过监控）\n- OpenAI 透传模式下的 400 invalid_encrypted_content 与上下文超长错误保留结构化的 type / code / param，客户端可据此正确处理\n\n## Bug 修复\n\n- 修复 OpenAI 透传错误脱敏在遇到特殊字符时可能崩溃或泄露上游主机名的问题\n- 修复 compact 流式响应中上游过载类错误未改写为可重试错误，导致 Codex 直接终止会话的问题\n- 修复上游分组名称或描述含非法字符时，倍率与探测结果整体写入失败并被反复重试的问题\n\n\n\n---\n\n## 📥 Installation\n\n**Docker:**\n```bash\n# Docker Hub\ndocker pull weishaw/sub2api:0.2.25\n\n# GitHub Container Registry\ndocker pull ghcr.io/wei-shaw/sub2api:0.2.25\n```\n\n**One-line install (Linux):**\n```bash\ncurl -sSL https://raw.githubusercontent.com/Wei-Shaw/sub2api/main/deploy/install.sh | sudo bash\n```\n\n**Manual download:**\nDownload the appropriate archive for your platform from the assets below.\n\n## 📚 Documentation\n\n- [GitHub Repository](https://github.com/Wei-Shaw/sub2api)\n- [Installation Guide](https://github.com/Wei-Shaw/sub2api/blob/main/deploy/README.md)\n\n","reactions":{"url":"https://api.github.com/repos/Wei-Shaw/sub2api/releases/456266173/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0}}