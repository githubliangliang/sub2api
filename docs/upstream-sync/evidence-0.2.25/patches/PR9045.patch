+	}
+	inner := sanitizeOpenAIPassthroughClientErrorText(account, extractUpstreamErrorCode(body))
+	if len(inner) > openAIPassthroughClientErrorFieldMaxBytes || strings.HasPrefix(inner, "{") || strings.HasPrefix(inner, "[") {
