+	for _, credKey := range []string{"api_key", "access_token", "refresh_token"} {
+		if secret := strings.TrimSpace(account.GetCredential(credKey)); len(secret) >= 6 {
+			sanitized = strings.ReplaceAll(sanitized, secret, "[redacted]")
+		}
