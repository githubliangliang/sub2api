+// 避免上游错误文案泄露真实上游地址或账号凭据。
+func sanitizeOpenAIPassthroughClientErrorText(account *Account, text string) string {
+	sanitized := sanitizeUpstreamErrorMessage(strings.TrimSpace(text))
+	if sanitized == "" || account == nil {
+		return sanitized
