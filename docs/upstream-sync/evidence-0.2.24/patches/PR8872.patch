+	raw   []byte
+	inner []byte
+	plain bool
+}
+
+func newOpenAIResponsesJSONKey(raw []byte) openAIResponsesJSONKey {
+	key := openAIResponsesJSONKey{raw: raw}
+	if len(raw) < 2 || raw[0] != '"' || raw[len(raw)-1] != '"' {
+		return key
+	}
+	key.inner = raw[1 : len(raw)-1]
+	key.plain = bytes.IndexByte(key.inner, '\\') < 0
+	return key
