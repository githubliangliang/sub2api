+			return sanitizeOpenAIResponsesToolSchemas(in, openAIResponsesToolSchemaOptions{
+				replaceNullParameterTypes:       true,
+				injectObjectUnionRootObjectType: true,
+				dropNullRequired:                true,
+			})
