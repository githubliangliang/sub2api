--- /dev/null
+++ b/backend/internal/pkg/websearch/exa.go
@@ -0,0 +1,112 @@
+package websearch
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"strings"
+)
+
+const (
+	exaSearchEndpoint = "https://api.exa.ai/search"
+	exaProviderName   = "exa"
+)
+
+// ExaProvider implements web search via the Exa Search API.
+type ExaProvider struct {
+	apiKey     string
+	httpClient *http.Client
+}
+
+// NewExaProvider creates an Exa Search provider.
+// The caller is responsible for configuring the http.Client with proxy/timeouts.
+func NewExaProvider(apiKey string, httpClient *http.Client) *ExaProvider {
+	if httpClient == nil {
+		httpClient = http.DefaultClient
+	}
+	return &ExaProvider{apiKey: apiKey, httpClient: httpClient}
+}
+
+func (e *ExaProvider) Name() string { return exaProviderName }
+
+func (e *ExaProvider) Search(ctx context.Context, req SearchRequest) (*SearchResponse, error) {
+	numResults := req.MaxResults
+	if numResults <= 0 {
+		numResults = defaultMaxResults
+	}
+
+	// Search type and highlight length are left to Exa's defaults.
+	payload := exaRequest{
+		Query:      req.Query,
+		NumResults: numResults,
+		Contents:   exaContents{Highlights: true},
+	}
+
+	bodyBytes, err := json.Marshal(payload)
+	if err != nil {
+		return nil, fmt.Errorf("exa: encode request: %w", err)
+	}
+
+	httpReq, err := http.NewRequestWithContext(ctx, http.MethodPost, exaSearchEndpoint, bytes.NewReader(bodyBytes))
+	if err != nil {
+		return nil, fmt.Errorf("exa: build request: %w", err)
+	}
+	httpReq.Header.Set("Content-Type", "application/json")
+	httpReq.Header.Set("x-api-key", e.apiKey)
+
+	resp, err := e.httpClient.Do(httpReq)
+	if err != nil {
+		return nil, fmt.Errorf("exa: request failed: %w", err)
+	}
+	defer func() { _ = resp.Body.Close() }()
+
+	body, err := io.ReadAll(io.LimitReader(resp.Body, maxResponseSize))
+	if err != nil {
+		return nil, fmt.Errorf("exa: read body: %w", err)
+	}
+
+	if resp.StatusCode != http.StatusOK {
+		return nil, fmt.Errorf("exa: status %d: %s", resp.StatusCode, truncateBody(body))
+	}
+
+	var raw exaResponse
+	if err := json.Unmarshal(body, &raw); err != nil {
+		return nil, fmt.Errorf("exa: decode response: %w", err)
+	}
+
+	results := make([]SearchResult, 0, len(raw.Results))
+	for _, r := range raw.Results {
+		results = append(results, SearchResult{
+			URL:     r.URL,
+			Title:   r.Title,
+			Snippet: strings.Join(r.Highlights, "\n"),
+			PageAge: r.PublishedDate,
+		})
+	}
+
+	return &SearchResponse{Results: results, Query: req.Query}, nil
+}
+
+type exaRequest struct {
+	Query      string      `json:"query"`
+	NumResults int         `json:"numResults"`
+	Contents   exaContents `json:"contents"`
+}
+
+type exaContents struct {
+	Highlights bool `json:"highlights"`
+}
+
+type exaResponse struct {
+	Results []exaResult `json:"results"`
+}
+
+type exaResult struct {
+	URL           string   `json:"url"`
+	Title         string   `json:"title"`
+	PublishedDate string   `json:"publishedDate"`
+	Highlights    []string `json:"highlights"`
+}
diff --git a/backend/internal/pkg/websearch/exa_test.go b/backend/internal/pkg/websearch/exa_test.go
new file mode 100644
index 000000000..d18d8742b
--- /dev/null
+++ b/backend/internal/pkg/websearch/exa_test.go
@@ -0,0 +1,91 @@
+package websearch
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+type exaRoundTripFunc func(*http.Request) (*http.Response, error)
+
+func (f exaRoundTripFunc) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+func exaTestClient(status int, body string, seen *http.Request, seenBody *[]byte) *http.Client {
+	return &http.Client{Transport: exaRoundTripFunc(func(r *http.Request) (*http.Response, error) {
+		*seen = *r
+		b, _ := io.ReadAll(r.Body)
+		*seenBody = b
+		return &http.Response{
+			StatusCode: status,
+			Body:       io.NopCloser(strings.NewReader(body)),
+			Header:     make(http.Header),
+		}, nil
+	})}
+}
+
+func TestExaProvider_Name(t *testing.T) {
+	require.Equal(t, "exa", NewExaProvider("key", nil).Name())
+}
+
+func TestManagerBuildsExaProvider(t *testing.T) {
+	p := (&Manager{}).buildProvider(ProviderConfig{Type: ProviderTypeExa, APIKey: "k"}, nil)
+	require.IsType(t, &ExaProvider{}, p)
+}
+
+func TestExaProvider_Search(t *testing.T) {
+	var seen http.Request
+	var seenBody []byte
+	resp := `{"requestId":"r1","results":[` +
+		`{"url":"https://go.dev","title":"Go","publishedDate":"2026-10-01T00:00:00.000Z","highlights":["Go is a language.","It compiles fast."]},` +
+		`{"url":"https://example.com","title":"Example","publishedDate":null,"highlights":[]}]}`
+	p := NewExaProvider("exa-key", exaTestClient(http.StatusOK, resp, &seen, &seenBody))
+
+	out, err := p.Search(context.Background(), SearchRequest{Query: "golang", MaxResults: 3})
+
+	require.NoError(t, err)
+	require.Equal(t, http.MethodPost, seen.Method)
+	require.Equal(t, "https://api.exa.ai/search", seen.URL.String())
+	require.Equal(t, "exa-key", seen.Header.Get("x-api-key"))
+	require.Equal(t, "application/json", seen.Header.Get("Content-Type"))
+	var body map[string]any
+	require.NoError(t, json.Unmarshal(seenBody, &body))
+	require.Equal(t, map[string]any{
+		"query":      "golang",
+		"numResults": float64(3),
+		"contents":   map[string]any{"highlights": true},
+	}, body)
+
+	require.Equal(t, "golang", out.Query)
+	require.Equal(t, []SearchResult{
+		{URL: "https://go.dev", Title: "Go", Snippet: "Go is a language.\nIt compiles fast.", PageAge: "2026-10-01T00:00:00.000Z"},
+		{URL: "https://example.com", Title: "Example"},
+	}, out.Results)
+}
+
+func TestExaProvider_SearchDefaultsNumResults(t *testing.T) {
+	var seen http.Request
+	var seenBody []byte
+	p := NewExaProvider("k", exaTestClient(http.StatusOK, `{"results":[]}`, &seen, &seenBody))
+
+	_, err := p.Search(context.Background(), SearchRequest{Query: "q"})
+
+	require.NoError(t, err)
+	var body map[string]any
+	require.NoError(t, json.Unmarshal(seenBody, &body))
+	require.Equal(t, float64(defaultMaxResults), body["numResults"])
+}
+
+func TestExaProvider_SearchHTTPError(t *testing.T) {
+	var seen http.Request
+	var seenBody []byte
+	p := NewExaProvider("bad", exaTestClient(http.StatusUnauthorized, `{"error":"invalid api key"}`, &seen, &seenBody))
+
+	_, err := p.Search(context.Background(), SearchRequest{Query: "q"})
+
+	require.ErrorContains(t, err, "exa: status 401")
+}
