+package securityaudit
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestEnqueuerNotifiesOnlyAfterPublish(t *testing.T) {
+	cases := []struct {
+		name       string
+		publishErr error
+		want       int
+	}{
+		{name: "published", want: 1},
+		{name: "publish failed", publishErr: errors.New("db down"), want: 0},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			repo := &fakeJobRepository{createJob: &Job{ID: 41}, publishErr: tc.publishErr}
+			enqueuer := NewEnqueuer(&fakeConfigStore{cfg: asyncConfig(), active: true}, repo, &fakePayloadStore{values: map[int64]string{}})
+			notified := 0
+			enqueuer.notify = func() { notified++ }
+			_ = enqueuer.Enqueue(context.Background(), asyncRequest())
+			require.Equal(t, tc.want, notified)
+		})
+	}
+}
+
+type startingPayloadStore struct {
+	PayloadStore
+	entered chan struct{}
+	release chan struct{}
+}
+
+func (s *startingPayloadStore) Ping(context.Context) error {
+	close(s.entered)
+	<-s.release
+	return nil
+}
+
+func TestRunnerShutdownWaitsForStartingWorkers(t *testing.T) {
+	payload := &startingPayloadStore{PayloadStore: &fakePayloadStore{values: map[int64]string{}}, entered: make(chan struct{}), release: make(chan struct{})}
+	runner := NewRunner(&fakeConfigStore{cfg: asyncConfig(), active: true}, &fakeJobRepository{}, payload, PromptScannerFunc(func(context.Context, ActiveEndpoint, string, []string) (*NormalizedResult, error) {
+		return integrationResult(EventPass), nil
+	}), NewAtomicMetrics())
+	started := make(chan error, 1)
+	go func() { started <- runner.Start(t.Context()) }()
+	<-payload.entered
+	stopped := make(chan error, 1)
+	go func() { stopped <- runner.Shutdown(t.Context()) }()
+	select {
+	case err := <-stopped:
+		close(payload.release)
+		<-started
+		t.Fatalf("Shutdown returned before starting workers were registered: %v", err)
+	case <-time.After(30 * time.Millisecond):
+	}
+	close(payload.release)
+	require.NoError(t, <-started)
+	require.NoError(t, <-stopped)
+	runner.mu.Lock()
+	require.Nil(t, runner.cancel)
+	runner.mu.Unlock()
+}
+
+func TestRunnerConcurrentLifecycleAndCoalescedWake(t *testing.T) {
+	runner := NewRunner(&fakeConfigStore{cfg: asyncConfig(), active: true}, &fakeJobRepository{}, &fakePayloadStore{values: map[int64]string{}}, PromptScannerFunc(func(context.Context, ActiveEndpoint, string, []string) (*NormalizedResult, error) {
+		return integrationResult(EventPass), nil
+	}), NewAtomicMetrics())
+	for round := 0; round < 4; round++ {
+		var wg sync.WaitGroup
+		for i := 0; i < 8; i++ {
+			wg.Add(1)
+			go func() {
+				defer wg.Done()
+				require.NoError(t, runner.Start(t.Context()))
+				for n := 0; n < 100; n++ {
+					runner.Notify()
+				}
+				require.NoError(t, runner.Shutdown(t.Context()))
+			}()
+		}
+		wg.Wait()
+	}
+	require.NoError(t, runner.Shutdown(t.Context()))
+}
+
+func TestEnqueuerAdmissionAndPayloadFailureNeverWake(t *testing.T) {
+	for _, failure := range []error{ErrQueueFull, ErrQueueAdmissionBusy, errors.New("database unavailable")} {
+		enqueuer := NewEnqueuer(&fakeConfigStore{cfg: asyncConfig(), active: true}, &fakeJobRepository{createErr: failure}, &fakePayloadStore{})
+		notified := false
+		enqueuer.notify = func() { notified = true }
+		require.ErrorIs(t, enqueuer.Enqueue(t.Context(), asyncRequest()), failure)
+		require.False(t, notified)
+	}
+	enqueuer := NewEnqueuer(&fakeConfigStore{cfg: asyncConfig(), active: true}, &fakeJobRepository{createJob: &Job{ID: 41}}, &fakePayloadStore{setErr: errors.New("payload down")})
+	notified := false
+	enqueuer.notify = func() { notified = true }
+	require.Error(t, enqueuer.Enqueue(t.Context(), asyncRequest()))
+	require.False(t, notified)
+}
+
+// Both cases must finish before the first fallback tick (workerIdlePoll), so they
+// exercise the start-up drain and the wake path rather than polling.
+func TestWorkerClaimsWithoutWaitingForIdlePoll(t *testing.T) {
+	newRunner := func(repo *fakeJobRepository) *Runner {
+		payload := &fakePayloadStore{values: map[int64]string{51: "abc"}}
+		return NewRunner(&fakeConfigStore{cfg: asyncConfig(), active: true}, repo, payload, PromptScannerFunc(func(context.Context, ActiveEndpoint, string, []string) (*NormalizedResult, error) {
+			return integrationResult(EventPass), nil
+		}), NewAtomicMetrics())
+	}
+	completed := func(repo *fakeJobRepository) func() bool {
+		return func() bool { repo.mu.Lock(); defer repo.mu.Unlock(); return repo.completeCount == 1 }
+	}
+	stop := func(t *testing.T, runner *Runner) {
+		ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+		defer cancel()
+		require.NoError(t, runner.Shutdown(ctx))
+	}
+
+	t.Run("jobs left from a previous run are drained at start", func(t *testing.T) {
+		repo := &fakeJobRepository{claimQueue: []*Job{workerJob(1, 3)}}
+		runner := newRunner(repo)
+		require.NoError(t, runner.Start(context.Background()))
+		defer stop(t, runner)
+		require.Eventually(t, completed(repo), workerIdlePoll/2, 5*time.Millisecond)
+	})
+
+	t.Run("notify wakes an idle worker", func(t *testing.T) {
+		repo := &fakeJobRepository{}
+		runner := newRunner(repo)
+		require.NoError(t, runner.Start(context.Background()))
+		defer stop(t, runner)
+		// wait for the start-up drain to find an empty queue
+		require.Eventually(t, func() bool { repo.mu.Lock(); defer repo.mu.Unlock(); return repo.claims > 0 }, workerIdlePoll/2, time.Millisecond)
+		repo.mu.Lock()
+		repo.claimQueue = append(repo.claimQueue, workerJob(1, 3))
+		repo.mu.Unlock()
+		runner.Notify()
+		require.Eventually(t, completed(repo), workerIdlePoll/2, 5*time.Millisecond)
+	})
+
+	t.Run("notify never blocks", func(t *testing.T) {
+		runner := newRunner(&fakeJobRepository{})
+		for i := 0; i < 3; i++ {
+			runner.Notify()
+		}
+		var nilRunner *Runner
+		nilRunner.Notify()
+	})
+}
diff --git a/backend/internal/service/auth_service_refresh_race_test.go b/backend/internal/service/auth_service_refresh_race_test.go
new file mode 100644
index 000000000..c177fc2ff
--- /dev/null
+++ b/backend/internal/service/auth_service_refresh_race_test.go
@@ -0,0 +1,104 @@
+//go:build unit
+
+package service_test
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"testing"
+
+	"github.com/Wei-Shaw/sub2api/internal/config"
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/stretchr/testify/require"
+)
+
+// barrierRefreshTokenCacheStub 让所有并发请求都先读到旧 token，再统一放行，
+// 从而确定性地复现 "Get 之后、消费之前" 的 double-spend 窗口。
+type barrierRefreshTokenCacheStub struct {
+	*emailBindRefreshTokenCacheStub
+
+	target  int
+	barrier chan struct{}
+	mu      sync.Mutex
+	reads   int
+}
+
+func newBarrierRefreshTokenCacheStub(target int) *barrierRefreshTokenCacheStub {
+	return &barrierRefreshTokenCacheStub{
+		emailBindRefreshTokenCacheStub: newEmailBindRefreshTokenCacheStub(),
+		target:                         target,
+		barrier:                        make(chan struct{}),
+	}
+}
+
+func (s *barrierRefreshTokenCacheStub) GetRefreshToken(ctx context.Context, tokenHash string) (*service.RefreshTokenData, error) {
+	data, err := s.emailBindRefreshTokenCacheStub.GetRefreshToken(ctx, tokenHash)
+
+	s.mu.Lock()
+	s.reads++
+	if s.reads == s.target {
+		close(s.barrier)
+	}
+	s.mu.Unlock()
+	<-s.barrier
+	return data, err
+}
+
+// 同一个 refresh token 并发刷新时，只能有一个请求成功兑换，其余必须失败。
+func TestAuthServiceRefreshTokenPairConsumesTokenOnce(t *testing.T) {
+	ctx := context.Background()
+	const workers = 8
+	cache := newBarrierRefreshTokenCacheStub(workers)
+
+	user := &service.User{
+		ID:           41,
+		Email:        "refresh-race@example.com",
+		Username:     "refresh-race",
+		Role:         service.RoleUser,
+		Status:       service.StatusActive,
+		TokenVersion: 1,
+	}
+	cfg := &config.Config{
+		JWT: config.JWTConfig{
+			Secret:                   "test-refresh-race-secret",
+			ExpireHour:               1,
+			AccessTokenExpireMinutes: 60,
+			RefreshTokenExpireDays:   7,
+		},
+	}
+	svc := service.NewAuthService(nil, newEmailBindUserRepoStub(user), nil, cache, cfg, nil, nil, nil, nil, nil, nil, nil, nil)
+
+	pair, err := svc.GenerateTokenPair(ctx, user, "")
+	require.NoError(t, err)
+
+	start := make(chan struct{})
+	errs := make(chan error, workers)
+	var wg sync.WaitGroup
+	for i := 0; i < workers; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			<-start
+			_, refreshErr := svc.RefreshTokenPair(ctx, pair.RefreshToken)
+			errs <- refreshErr
+		}()
+	}
+	close(start)
+	wg.Wait()
+	close(errs)
+
+	successes, invalid := 0, 0
+	for refreshErr := range errs {
+		switch {
+		case refreshErr == nil:
+			successes++
+		case errors.Is(refreshErr, service.ErrRefreshTokenInvalid):
+			invalid++
+		default:
+			t.Fatalf("unexpected refresh error: %v", refreshErr)
+		}
+	}
+	require.Equal(t, 1, successes)
+	require.Equal(t, workers-1, invalid)
+}
diff --git a/backend/internal/service/openai_ws_search_activation.go b/backend/internal/service/openai_ws_search_activation.go
new file mode 100644
index 000000000..6d1e640c1
--- /dev/null
+++ b/backend/internal/service/openai_ws_search_activation.go
@@ -0,0 +1,60 @@
+package service
+
+import (
+	"encoding/json"
+
+	"github.com/tidwall/gjson"
+)
+
+func openAIWSWebSearchDeclared(payload []byte) bool {
+	fields := gjson.GetMany(openAIWSPayloadStringView(payload), "tools", "input")
+	if gjsonToolsContainWebSearch(fields[0]) {
+		return true
+	}
+	for _, item := range fields[1].Array() {
+		if item.Get("type").String() == openAIAdditionalToolsItemType && gjsonToolsContainWebSearch(item.Get("tools")) {
+			return true
+		}
+	}
+	return false
+}
+
+// Called under writeMu, only after the first response.create was written.
+func (c *openAIWSConn) recordInitialWebSearch(value any) {
+	var body []byte
+	switch payload := value.(type) {
+	case json.RawMessage:
+		body = payload
+	case []byte:
+		body = payload
+	case map[string]any:
+		if payload["type"] != "response.create" {
+			return
+		}
+		c.responseCreateSent = true
+		c.initialWebSearch = openAIToolsContainWebSearch(payload["tools"])
+		input, _ := payload["input"].([]any)
+		for _, raw := range input {
+			if item, ok := raw.(map[string]any); ok && item["type"] == openAIAdditionalToolsItemType && openAIToolsContainWebSearch(item["tools"]) {
+				c.initialWebSearch = true
+			}
+		}
+		return
+	default:
+		return
+	}
+	if gjson.GetBytes(body, "type").String() == "response.create" {
+		c.responseCreateSent = true
+		c.initialWebSearch = openAIWSWebSearchDeclared(body)
+	}
+}
+
+func (l *openAIWSConnLease) initializedWithoutWebSearch() bool {
+	c, err := l.activeConn()
+	if err != nil {
+		return false
+	}
+	c.writeMu.Lock()
+	defer c.writeMu.Unlock()
+	return c.responseCreateSent && !c.initialWebSearch
+}
