+
+	"github.com/Wei-Shaw/sub2api/internal/config"
+	coderws "github.com/coder/websocket"
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/require"
+	"github.com/tidwall/gjson"
+)
+
+func TestOpenAIWSIngressWebSearchActivation(t *testing.T) {
+	const search = `,"tools":[{"type":"web_search","external_web_access":false}]`
+	const userInput = `[{"type":"message","role":"user","content":"continue"}]`
+	const toolOutput = `[{"type":"function_call_output","call_id":"fc_lookup","output":"42"}]`
+	const firstOutput = `[{"type":"reasoning","id":"rs_first","summary":[{"type":"summary_text","text":"Keep this reasoning"}]},{"type":"message","id":"msg_first","role":"assistant","content":[{"type":"output_text","text":"Keep this answer"}]},{"type":"function_call","id":"fc_lookup","call_id":"fc_lookup","name":"lookup","arguments":"{}"}]`
+	for _, tc := range []struct {
+		name          string
+		accountType   string
+		firstFields   string
+		firstInput    string
+		firstOutput   string
+		nextFields    string
+		nextInput     string
+		nextPrevious  string
+		wantReconnect bool
+		wantFailClose bool
+		wantTypes     []string
+	}{
+		{name: "empty OAuth prewarm", accountType: AccountTypeOAuth, firstFields: `,"generate":false`, nextFields: search, nextInput: userInput, wantReconnect: true, wantTypes: []string{"message"}},
+		{name: "Lite search history injection", accountType: AccountTypeOAuth, firstFields: `,"generate":false`, nextFields: `,"client_metadata":{"ws_request_header_x_openai_internal_codex_responses_lite":"true"}`, nextInput: `[{"type":"web_search_call","id":"ws_history","status":"completed","action":{"type":"search","query":"example"}},{"type":"message","role":"user","content":"continue"}]`, wantReconnect: true, wantTypes: []string{"web_search_call", "message", "additional_tools"}},
+		{name: "tool continuation preserves all output", accountType: AccountTypeOAuth, firstFields: `,"tools":[{"type":"function","name":"lookup","parameters":{"type":"object"}}]`, firstInput: `[{"type":"message","role":"user","content":"Run lookup for my original question"}]`, firstOutput: firstOutput, nextFields: search, nextInput: toolOutput, wantReconnect: true, wantTypes: []string{"message", "reasoning", "message", "function_call", "function_call_output"}},
+		{name: "search initialized socket", accountType: AccountTypeOAuth, firstFields: search, nextFields: search, nextInput: userInput},
+		{name: "API key provider", accountType: AccountTypeAPIKey, firstFields: `,"generate":false`, nextFields: search, nextInput: userInput},
+		{name: "function called web_search", accountType: AccountTypeOAuth, nextFields: `,"tools":[{"type":"function","name":"web_search","parameters":{"type":"object"}}]`, nextInput: userInput},
+		{name: "missing tool context fails closed", accountType: AccountTypeOAuth, nextFields: search, nextInput: toolOutput, wantFailClose: true},
+		{name: "unknown response history fails closed", accountType: AccountTypeOAuth, nextFields: search, nextInput: userInput, nextPrevious: "resp_unknown", wantFailClose: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			gin.SetMode(gin.TestMode)
+			cfg := &config.Config{}
+			cfg.Security.URLAllowlist.Enabled = false
+			cfg.Gateway.OpenAIWS.Enabled = true
+			cfg.Gateway.OpenAIWS.OAuthEnabled = true
+			cfg.Gateway.OpenAIWS.APIKeyEnabled = true
+			cfg.Gateway.OpenAIWS.ResponsesWebsocketsV2 = true
+			cfg.Gateway.OpenAIWS.MaxConnsPerAccount = 2
+			cfg.Gateway.OpenAIWS.MaxIdlePerAccount = 2
+			cfg.Gateway.OpenAIWS.QueueLimitPerConn = 8
+			cfg.Gateway.OpenAIWS.DialTimeoutSeconds = 3
+			cfg.Gateway.OpenAIWS.ReadTimeoutSeconds = 3
+			cfg.Gateway.OpenAIWS.WriteTimeoutSeconds = 3
+			output := tc.firstOutput
+			if output == "" {
+				output = "[]"
+			}
+			events := [][]byte{
+				[]byte(fmt.Sprintf(`{"type":"response.completed","response":{"id":"resp_first","model":"gpt-6.1-sol","output":%s,"usage":{"input_tokens":1,"output_tokens":1}}}`, output)),
+				[]byte(`{"type":"response.completed","response":{"id":"resp_second","model":"gpt-6.1-sol","output":[],"usage":{"input_tokens":1,"output_tokens":1}}}`),
+				[]byte(`{"type":"response.completed","response":{"id":"resp_third","model":"gpt-6.1-sol","output":[],"usage":{"input_tokens":1,"output_tokens":1}}}`),
+				[]byte(`{"type":"response.completed","response":{"id":"resp_fourth","model":"gpt-6.1-sol","output":[],"usage":{"input_tokens":1,"output_tokens":1}}}`),
+			}
+			first := &openAIWSCaptureConn{events: append([][]byte(nil), events...)}
+			second := &openAIWSCaptureConn{events: append([][]byte(nil), events[1:]...)}
+			dialer := &openAIWSQueueDialer{conns: []openAIWSClientConn{first, second}}
+			pool := newOpenAIWSConnPool(cfg)
+			pool.setClientDialerForTest(dialer)
+			t.Cleanup(pool.Close)
+			svc := &OpenAIGatewayService{cfg: cfg, httpUpstream: &httpUpstreamRecorder{}, cache: &stubGatewayCache{}, openaiWSResolver: NewOpenAIWSProtocolResolver(cfg), toolCorrector: NewCodexToolCorrector(), openaiWSPool: pool}
+			account := &Account{ID: 71, Platform: PlatformOpenAI, Type: tc.accountType, Status: StatusActive, Schedulable: true, Concurrency: 1,
+				Credentials: map[string]any{"access_token": "test-token", "api_key": "test-token"},
+				Extra:       map[string]any{"responses_websockets_v2_enabled": true}}
+			serverErr := make(chan error, 1)
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				conn, err := coderws.Accept(w, r, nil)
+				if err != nil {
+					serverErr <- err
+					return
+				}
+				defer func() { _ = conn.CloseNow() }()
+				c, _ := gin.CreateTestContext(httptest.NewRecorder())
+				c.Request = r
+				ctx, cancel := context.WithTimeout(r.Context(), 10*time.Second)
+				defer cancel()
+				_, payload, err := conn.Read(ctx)
+				if err == nil {
+					err = svc.ProxyResponsesWebSocketFromClient(ctx, c, conn, account, "test-token", payload, nil)
+				}
+				serverErr <- err
+			}))
+			defer server.Close()
+			ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+			defer cancel()
+			client, _, err := coderws.Dial(ctx, "ws"+strings.TrimPrefix(server.URL, "http"), nil)
+			require.NoError(t, err)
+			defer func() { _ = client.CloseNow() }()
+			write := func(fields, input string) {
+				payload := fmt.Sprintf(`{"type":"response.create","model":"gpt-6.1-sol","store":false,"input":%s%s}`, input, fields)
+				require.NoError(t, client.Write(ctx, coderws.MessageText, []byte(payload)))
+			}
+			read := func(id string) {
+				_, event, err := client.Read(ctx)
+				require.NoError(t, err)
+				require.Equal(t, id, gjson.GetBytes(event, "response.id").String())
+			}
+			input := tc.firstInput
+			if input == "" {
+				input = "[]"
+			}
+			write(tc.firstFields, input)
+			read("resp_first")
+			previous := tc.nextPrevious
+			if previous == "" {
+				previous = "resp_first"
+			}
+			write(fmt.Sprintf(`,"previous_response_id":%q`, previous)+tc.nextFields, tc.nextInput)
+			if tc.wantFailClose {
+				_, _, err := client.Read(ctx)
+				require.Error(t, err)
+				require.Error(t, <-serverErr)
+				require.Len(t, first.writes, 1, "unsafe continuation must not reach upstream")
+				return
+			}
+			read("resp_second")
+			// Removing and restoring search must keep the search-initialized socket.
+			write(`,"previous_response_id":"resp_second"`, userInput)
+			read("resp_third")
+			write(`,"previous_response_id":"resp_third"`+tc.nextFields, userInput)
+			read("resp_fourth")
+			require.NoError(t, client.Close(coderws.StatusNormalClosure, "done"))
+			require.NoError(t, <-serverErr)
+			if !tc.wantReconnect {
+				require.Equal(t, 1, dialer.DialCount())
+				require.Len(t, first.writes, 4)
+				return
+			}
+			require.Equal(t, 2, dialer.DialCount())
+			require.Len(t, first.writes, 1, "search must never be sent on the incompatible socket")
+			require.Len(t, second.writes, 3)
+			forwarded, err := json.Marshal(second.writes[0])
+			require.NoError(t, err)
+			require.False(t, gjson.GetBytes(forwarded, "previous_response_id").Exists())
+			var types []string
+			for _, item := range gjson.GetBytes(forwarded, "input").Array() {
+				types = append(types, item.Get("type").String())
+			}
+			require.Equal(t, tc.wantTypes, types)
+			if tc.firstOutput != "" {
+				require.Contains(t, string(forwarded), "Run lookup for my original question")
+				require.Contains(t, string(forwarded), "Keep this reasoning")
+				require.Contains(t, string(forwarded), "Keep this answer")
+				require.Contains(t, string(forwarded), `"output":"42"`)
+			}
+		})
+	}
+}
+
+type failedSearchWriteConn struct{ openAIWSClientConn }
+
+func (failedSearchWriteConn) WriteJSON(context.Context, any) error {
+	return errors.New("fixture write failed")
+}
+
+func TestOpenAIWSFailedWriteDoesNotInitializeSearchCapability(t *testing.T) {
+	conn := newOpenAIWSConn("failed", 1, failedSearchWriteConn{&openAIWSCaptureConn{}}, nil)
+	defer conn.close()
+	lease := &openAIWSConnLease{conn: conn}
+	require.Error(t, lease.WriteJSON(json.RawMessage(`{"type":"response.create","input":[]}`), time.Second))
+	require.False(t, lease.initializedWithoutWebSearch())
+}
+
+func TestOpenAIWSConnWebSearchInitialization(t *testing.T) {
+	const search = `{"type":"response.create","tools":[{"type":"web_search"}]}`
+	for _, first := range []struct {
+		name          string
+		body          string
+		wantReconnect bool
+	}{
+		{"empty prewarm", `{"type":"response.create","generate":false,"input":[]}`, true},
+		{"hosted search", search, false},
+		{"Lite hosted search", `{"type":"response.create","input":[{"type":"additional_tools","tools":[{"type":"web_search"}]}]}`, false},
+		{"function lookalike", `{"type":"response.create","tools":[{"type":"function","name":"web_search"}]}`, true},
+	} {
+		for _, format := range []string{"map", "raw", "bytes"} {
+			t.Run(first.name+"/"+format, func(t *testing.T) {
+				conn := newOpenAIWSConn("test", 1, &openAIWSCaptureConn{}, nil)
+				defer conn.close()
+				lease := &openAIWSConnLease{conn: conn}
+				require.False(t, lease.initializedWithoutWebSearch(), "an unused socket is compatible")
+				var payload any
+				switch format {
+				case "map":
+					require.NoError(t, json.Unmarshal([]byte(first.body), &payload))
+				case "raw":
+					payload = json.RawMessage(first.body)
+				case "bytes":
+					payload = []byte(first.body)
+				}
+				require.NoError(t, lease.WriteJSON(payload, time.Second))
+				// Capability belongs to the socket, even after it is leased again.
+				lease = &openAIWSConnLease{conn: conn}
+				require.Equal(t, first.wantReconnect, lease.initializedWithoutWebSearch())
+				require.NoError(t, lease.WriteJSON(json.RawMessage(search), time.Second))
+				require.Equal(t, first.wantReconnect, lease.initializedWithoutWebSearch(), "later writes cannot change initial capability")
+			})
+		}
+	}
+}
diff --git a/backend/internal/service/openai_ws_v2_passthrough_ttft_mode_test.go b/backend/internal/service/openai_ws_v2_passthrough_ttft_mode_test.go
new file mode 100644
index 000000000..30b0bed19
--- /dev/null
+++ b/backend/internal/service/openai_ws_v2_passthrough_ttft_mode_test.go
@@ -0,0 +1,206 @@
+package service
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/Wei-Shaw/sub2api/internal/config"
+	coderws "github.com/coder/websocket"
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/require"
+	"github.com/tidwall/gjson"
+)
+
+type openAIWSTTFTModeTestEvent struct {
+	delay   time.Duration
+	payload string
+}
+
+// openAIWSTTFTModeTestTurn replays a reasoning turn: the reasoning item is
+// announced shortly after the out-of-band codex.* frame, the first delta only
+// arrives after the reasoning ends.
+func openAIWSTTFTModeTestTurn(responseID string, startDelay, reasoningDelay time.Duration) []openAIWSTTFTModeTestEvent {
+	return []openAIWSTTFTModeTestEvent{
+		{startDelay, `{"type":"response.created","response":{"id":"` + responseID + `","model":"gpt-5.4"}}`},
+		{0, `{"type":"codex.rate_limits","rate_limits":{"primary":{"used_percent":1}}}`},
+		{0, `{"type":"response.in_progress","response":{"id":"` + responseID + `"}}`},
+		{300 * time.Millisecond, `{"type":"response.output_item.added","output_index":0,"item":{"id":"rs_` + responseID + `","type":"reasoning","summary":[]}}`},
+		{reasoningDelay, `{"type":"response.output_text.delta","output_index":1,"delta":"Hi"}`},
+		{0, `{"type":"response.completed","response":{"id":"` + responseID + `","model":"gpt-5.4","usage":{"input_tokens":3,"output_tokens":2}}}`},
+	}
+}
+
+// openAIWSTTFTModeHTTPExpectedMs is the first-token time the SSE path would
+// report for the same events: the delay up to the first event that
+// openAIStreamDataStartsTTFT accepts. codex.* frames only exist on WebSocket.
+func openAIWSTTFTModeHTTPExpectedMs(t *testing.T, events []openAIWSTTFTModeTestEvent, mode string) time.Duration {
+	t.Helper()
+	var elapsed time.Duration
+	for _, event := range events {
+		elapsed += event.delay
+		eventType := gjson.Get(event.payload, "type").String()
+		if strings.HasPrefix(eventType, "codex.") {
+			continue
+		}
+		if openAIStreamDataStartsTTFT(event.payload, eventType, false, mode) {
+			return elapsed - events[0].delay
+		}
+	}
+	t.Fatalf("no first-token event for mode %s", mode)
+	return 0
+}
+
+func TestOpenAIWSPassthroughFirstTokenFollowsTTFTMode(t *testing.T) {
+	for _, ingress := range []string{OpenAIWSIngressModePassthrough, OpenAIWSIngressModeCtxPool} {
+		for _, mode := range []string{OpenAITTFTModeSemantic, OpenAITTFTModeVisible} {
+			t.Run(ingress+"/"+mode, func(t *testing.T) {
+				runOpenAIWSPassthroughTTFTModeCase(t, mode, ingress)
+			})
+		}
+	}
+}
+
+func runOpenAIWSPassthroughTTFTModeCase(t *testing.T, mode, ingress string) {
+	gin.SetMode(gin.TestMode)
+	gatewayForwardingCache.Store(&cachedGatewayForwardingSettings{openAITTFTMode: mode, expiresAt: time.Now().Add(time.Minute).UnixNano()})
+	t.Cleanup(func() {
+		gatewayForwardingCache.Store(&cachedGatewayForwardingSettings{openAITTFTMode: OpenAITTFTModeSemantic, expiresAt: time.Now().Add(time.Minute).UnixNano()})
+	})
+
+	const reasoningDelay = 600 * time.Millisecond
+	const tolerance = 250 * time.Millisecond
+	// The second turn's events wait so its response.create is accepted first.
+	turns := [][]openAIWSTTFTModeTestEvent{
+		openAIWSTTFTModeTestTurn("resp_ttft_1", 0, reasoningDelay),
+		openAIWSTTFTModeTestTurn("resp_ttft_2", 200*time.Millisecond, reasoningDelay),
+	}
+
+	upstreamConn := &openAIWSCaptureConn{}
+	for _, turn := range turns {
+		for _, event := range turn {
+			upstreamConn.events = append(upstreamConn.events, []byte(event.payload))
+			upstreamConn.readDelays = append(upstreamConn.readDelays, event.delay)
+		}
+	}
+
+	cfg := &config.Config{}
+	cfg.Security.URLAllowlist.Enabled = false
+	cfg.Security.URLAllowlist.AllowInsecureHTTP = true
+	cfg.Gateway.OpenAIWS.Enabled = true
+	cfg.Gateway.OpenAIWS.APIKeyEnabled = true
+	cfg.Gateway.OpenAIWS.ResponsesWebsocketsV2 = true
+	cfg.Gateway.OpenAIWS.ModeRouterV2Enabled = true
+	cfg.Gateway.OpenAIWS.IngressModeDefault = OpenAIWSIngressModeCtxPool
+	cfg.Gateway.OpenAIWS.DialTimeoutSeconds = 3
+	cfg.Gateway.OpenAIWS.ReadTimeoutSeconds = 3
+	cfg.Gateway.OpenAIWS.WriteTimeoutSeconds = 3
+	svc := &OpenAIGatewayService{
+		cfg:                       cfg,
+		httpUpstream:              &httpUpstreamRecorder{},
+		cache:                     &stubGatewayCache{},
+		openaiWSResolver:          NewOpenAIWSProtocolResolver(cfg),
+		toolCorrector:             NewCodexToolCorrector(),
+		openaiWSPassthroughDialer: &openAIWSCaptureDialer{conn: upstreamConn},
+	}
+	account := &Account{
+		ID: 454, Name: "openai-ws-ttft-mode", Platform: PlatformOpenAI, Type: AccountTypeAPIKey,
+		Status: StatusActive, Schedulable: true, Concurrency: 1,
+		Credentials: map[string]any{"api_key": "sk-test"},
+		Extra:       map[string]any{"openai_apikey_responses_websockets_v2_mode": ingress},
+	}
+
+	if ingress == OpenAIWSIngressModeCtxPool {
+		pool := newOpenAIWSConnPool(cfg)
+		pool.setClientDialerForTest(&openAIWSCaptureDialer{conn: upstreamConn})
+		svc.openaiWSPool = pool
+		t.Cleanup(pool.Close)
+	}
+	resultCh := make(chan *OpenAIForwardResult, len(turns))
+	hooks := &OpenAIWSIngressHooks{
+		AfterTurn: func(_ int, result *OpenAIForwardResult, turnErr error) {
+			if turnErr == nil && result != nil {
+				resultCh <- result
+			}
+		},
+	}
+	wsServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		conn, err := coderws.Accept(w, r, nil)
+		if err != nil {
+			return
+		}
+		defer func() { _ = conn.CloseNow() }()
+		ginCtx, _ := gin.CreateTestContext(httptest.NewRecorder())
+		ginCtx.Request = r.Clone(r.Context())
+		readCtx, cancel := context.WithTimeout(r.Context(), 3*time.Second)
+		_, firstMessage, readErr := conn.Read(readCtx)
+		cancel()
+		if readErr != nil {
+			return
+		}
+		_ = svc.ProxyResponsesWebSocketFromClient(r.Context(), ginCtx, conn, account, "sk-test", firstMessage, hooks)
+	}))
+	defer wsServer.Close()
+
+	dialCtx, cancelDial := context.WithTimeout(context.Background(), 3*time.Second)
+	clientConn, _, err := coderws.Dial(dialCtx, "ws"+strings.TrimPrefix(wsServer.URL, "http"), nil)
+	cancelDial()
+	require.NoError(t, err)
+	defer func() { _ = clientConn.CloseNow() }()
+
+	request := []byte(`{"type":"response.create","model":"gpt-5.4","input":"hi"}`)
+	for i, turn := range turns {
+		writeCtx, cancelWrite := context.WithTimeout(context.Background(), 3*time.Second)
+		require.NoError(t, clientConn.Write(writeCtx, coderws.MessageText, request))
+		cancelWrite()
+		for {
+			readCtx, cancelRead := context.WithTimeout(context.Background(), 5*time.Second)
+			_, message, readErr := clientConn.Read(readCtx)
+			cancelRead()
+			require.NoError(t, readErr)
+			if gjson.GetBytes(message, "type").String() == "response.completed" {
+				break
+			}
+		}
+
+		var result *OpenAIForwardResult
+		select {
+		case result = <-resultCh:
+		case <-time.After(5 * time.Second):
+			t.Fatalf("turn %d result was not reported", i+1)
+		}
+		expected := openAIWSTTFTModeHTTPExpectedMs(t, turn, mode)
+		if ingress == OpenAIWSIngressModeCtxPool {
+			expected += turn[0].delay
+		}
+		require.NotNil(t, result.FirstTokenMs, "turn %d must record first token", i+1)
+		got := time.Duration(*result.FirstTokenMs) * time.Millisecond
+		require.GreaterOrEqual(t, got, expected, "turn %d first token must not precede the SSE first-token event", i+1)
+		require.Less(t, got, expected+tolerance, "turn %d first token must match the SSE rule for mode %s", i+1, mode)
+	}
+	_ = clientConn.Close(coderws.StatusNormalClosure, "done")
+}
+
+func TestOpenAIWSTTFTClassificationBoundaries(t *testing.T) {
+	for _, tc := range []struct {
+		payload           string
+		semantic, visible bool
+	}{
+		{`{"type":"codex.rate_limits"}`, false, false},
+		{`{"type":"response.created"}`, false, false},
+		{`{"type":"response.output_text.delta","delta":""}`, true, false},
+		{`{"type":"response.output_text.delta","delta":"text"}`, true, true},
+		{`{"type":"response.function_call_arguments.delta","delta":"{}"}`, true, true},
+		{`{"type":"response.output_item.added","item":{"type":"reasoning"}}`, true, false},
+		{`{"type":"response.completed","response":{"output":[]}}`, false, false},
+		{`{"type":"response.failed"}`, false, false},
+		{`{"type":"response.cancelled"}`, false, false},
+	} {
+		event := gjson.Get(tc.payload, "type").String()
+		require.Equal(t, tc.semantic, openAIWSFirstTokenEventFunc(OpenAITTFTModeSemantic)(event, []byte(tc.payload)), tc.payload)
+		require.Equal(t, tc.visible, openAIWSFirstTokenEventFunc(OpenAITTFTModeVisible)(event, []byte(tc.payload)), tc.payload)
+	}
+}
