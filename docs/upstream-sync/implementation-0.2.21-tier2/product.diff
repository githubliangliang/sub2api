+)
+
+func TestCapacityModelCooldownHTTPPersistsSQLiteAndSchedulerCache(t *testing.T) {
+	ctx := context.Background()
+	repo, client := newOllamaCloudUsageSQLiteRepository(t)
+	_, err := repo.sql.ExecContext(ctx, `CREATE TABLE scheduler_outbox(id INTEGER PRIMARY KEY AUTOINCREMENT,event_type TEXT NOT NULL,account_id INTEGER,group_id INTEGER,payload TEXT,created_at DATETIME DEFAULT CURRENT_TIMESTAMP,dedup_key TEXT UNIQUE)`)
+	require.NoError(t, err)
+	disabled := false
+	cfg := &config.Config{Redis: config.RedisConfig{Enabled: &disabled}, Security: config.SecurityConfig{URLAllowlist: config.URLAllowlistConfig{Enabled: false, AllowInsecureHTTP: true}}}
+	rdb := InitRedis(cfg)
+	defer func() { _ = rdb.Close() }()
+	scheduler := NewSchedulerCache(rdb)
+	repo.schedulerCache = scheduler
+	limits := service.NewRateLimitService(repo, nil, cfg, nil, NewTempUnschedCache(rdb))
+	for i, transport := range []string{"http", "sse", "buffered"} {
+		t.Run(transport, func(t *testing.T) {
+			upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if transport == "http" {
+					w.WriteHeader(503)
+					_, _ = io.WriteString(w, `{"error":{"code":"server_is_overloaded","message":"capacity fixture"}}`)
+					return
+				}
+				w.Header().Set("Content-Type", "text/event-stream")
+				_, _ = io.WriteString(w, "data: {\"type\":\"response.failed\",\"response\":{\"error\":{\"code\":\"slow_down\",\"message\":\"capacity fixture\"}}}\n\n")
+			}))
+			defer upstream.Close()
+			credentials := map[string]any{"api_key": "fixture", "base_url": upstream.URL, "model_mapping": map[string]any{"alias": "gpt-6.1-sol"}, "temp_unschedulable_enabled": true, "temp_unschedulable_rules": []any{map[string]any{"error_code": 503, "keywords": []any{"capacity fixture"}, "duration_minutes": 1, "scope": "model"}}}
+			created, err := client.Account.Create().SetName(fmt.Sprintf("capacity-%d", i)).SetPlatform(service.PlatformOpenAI).SetType(service.AccountTypeAPIKey).SetCredentials(credentials).SetExtra(map[string]any{}).Save(ctx)
+			require.NoError(t, err)
+			account, err := repo.GetByID(ctx, created.ID)
+			require.NoError(t, err)
+			svc := service.NewOpenAIGatewayService(repo, nil, nil, nil, nil, nil, nil, cfg, nil, nil, nil, limits, nil, cacheHitHTTPUpstream{upstream.Client()}, service.NewDeferredService(nil, nil, time.Hour), nil, nil, nil, nil, nil, nil, nil)
+			body := fmt.Sprintf(`{"model":"alias","input":"hello","stream":%t}`, transport != "buffered")
+			c, _ := gin.CreateTestContext(httptest.NewRecorder())
+			c.Request = httptest.NewRequest("POST", "/v1/responses", strings.NewReader(body))
+			_, err = svc.Forward(ctx, c, account, []byte(body))
+			var failover *service.UpstreamFailoverError
+			require.ErrorAs(t, err, &failover)
+			require.False(t, failover.RetryableOnSameAccount)
+			persisted, err := repo.GetByID(ctx, created.ID)
+			require.NoError(t, err)
+			cached, err := scheduler.GetAccount(ctx, created.ID)
+			require.NoError(t, err)
+			require.NotNil(t, cached)
+			for _, state := range []*service.Account{persisted, cached} {
+				require.False(t, state.IsSchedulableForModelWithContext(ctx, "alias"))
+				require.True(t, state.IsSchedulableForModelWithContext(ctx, "unrelated"))
+				require.Nil(t, state.TempUnschedulableUntil)
+			}
+		})
+	}
+}
diff --git a/backend/internal/repository/prompt_worker_wake_sqlite_test.go b/backend/internal/repository/prompt_worker_wake_sqlite_test.go
new file mode 100644
index 000000000..848063afe
--- /dev/null
+++ b/backend/internal/repository/prompt_worker_wake_sqlite_test.go
@@ -0,0 +1,108 @@
+package repository
+
+import (
+	"context"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/Wei-Shaw/sub2api/internal/securityaudit"
+	"github.com/stretchr/testify/require"
+)
+
+type sqliteWakeConfig struct {
+	securityaudit.ConfigStore
+	cfg securityaudit.ActiveConfig
+}
+
+func (c sqliteWakeConfig) Active() (securityaudit.ActiveConfig, bool) { return c.cfg, true }
+
+type sqliteWakePayload struct {
+	mu     sync.Mutex
+	values map[int64]string
+}
+
+func (p *sqliteWakePayload) Set(_ context.Context, id int64, value string, _ time.Duration) error {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	p.values[id] = value
+	return nil
+}
+func (p *sqliteWakePayload) Get(_ context.Context, id int64) (string, error) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	return p.values[id], nil
+}
+func (p *sqliteWakePayload) Delete(_ context.Context, id int64) error {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	delete(p.values, id)
+	return nil
+}
+func (p *sqliteWakePayload) Ping(context.Context) error { return nil }
+
+type observedSQLiteWakeRepo struct {
+	securityaudit.JobRepository
+	claims atomic.Int64
+}
+
+func (r *observedSQLiteWakeRepo) ClaimNextJob(ctx context.Context, now time.Time) (*securityaudit.Job, bool, error) {
+	r.claims.Add(1)
+	return r.JobRepository.ClaimNextJob(ctx, now)
+}
+
+type sqliteWakeScanner func(context.Context, securityaudit.ActiveEndpoint, string, []string) (*securityaudit.NormalizedResult, error)
+
+func (f sqliteWakeScanner) Scan(ctx context.Context, e securityaudit.ActiveEndpoint, s string, ids []string) (*securityaudit.NormalizedResult, error) {
+	return f(ctx, e, s, ids)
+}
+
+func TestPromptWorkerWakeAndRetryRunOnSQLite(t *testing.T) {
+	registerSQLitePGCompatFunctions()
+	db := openUsageStatsSQLite(t)
+	repo := &observedSQLiteWakeRepo{JobRepository: securityaudit.NewPostgreSQLRepository(db)}
+	payload := &sqliteWakePayload{values: map[int64]string{}}
+	cfg := sqliteWakeConfig{cfg: securityaudit.ActiveConfig{RiskControlEnabled: true, Enabled: true, WorkerCount: 1, QueueCapacity: 8, Scanners: []string{"prompt_injection"}, Endpoints: []securityaudit.ActiveEndpoint{{ID: "fixture", Enabled: true, InputLimit: 1000}}}}
+	scanned := make(chan struct{}, 2)
+	runner := securityaudit.NewRunner(cfg, repo, payload, sqliteWakeScanner(func(context.Context, securityaudit.ActiveEndpoint, string, []string) (*securityaudit.NormalizedResult, error) {
+		scanned <- struct{}{}
+		return &securityaudit.NormalizedResult{Decision: securityaudit.EventPass}, nil
+	}), securityaudit.NewAtomicMetrics())
+	require.NoError(t, runner.Start(t.Context()))
+	defer func() { require.NoError(t, runner.Shutdown(t.Context())) }()
+	require.Eventually(t, func() bool { return repo.claims.Load() > 0 }, time.Second, time.Millisecond)
+	create := func() *securityaudit.Job {
+		job, err := repo.CreateStagingWithCapacity(t.Context(), securityaudit.PromptSnapshot{RequestID: "wake-fixture"}, 1, 3, 8)
+		require.NoError(t, err)
+		require.NoError(t, payload.Set(t.Context(), job.ID, "hello", time.Minute))
+		return job
+	}
+	job := create()
+	require.NoError(t, repo.PublishQueued(t.Context(), job.ID))
+	var rawDue, normalizedDue int
+	require.NoError(t, db.QueryRow("SELECT COUNT(*) FROM prompt_audit_jobs WHERE next_attempt_at<=?", time.Now().UTC()).Scan(&rawDue))
+	require.NoError(t, db.QueryRow("SELECT COUNT(*) FROM prompt_audit_jobs WHERE julianday(next_attempt_at)<=julianday(?)", time.Now().UTC()).Scan(&normalizedDue))
+	t.Logf("SQLite due comparison raw=%d normalized=%d", rawDue, normalizedDue)
+	started := time.Now()
+	runner.Notify()
+	select {
+	case <-scanned:
+		t.Logf("actual SQLite claim wake latency=%s", time.Since(started))
+	case <-time.After(250 * time.Millisecond):
+		t.Fatal("local wake waited for fallback polling")
+	}
+	require.Eventually(t, func() bool {
+		var status string
+		return db.QueryRow("SELECT status FROM prompt_audit_jobs WHERE id=?", job.ID).Scan(&status) == nil && status == "done"
+	}, time.Second, time.Millisecond)
+	// No Notify: a due retry must still be picked up by fallback polling.
+	retry := create()
+	_, err := db.Exec("UPDATE prompt_audit_jobs SET status='retry',next_attempt_at=? WHERE id=?", time.Now().Add(50*time.Millisecond).UTC(), retry.ID)
+	require.NoError(t, err)
+	select {
+	case <-scanned:
+	case <-time.After(1500 * time.Millisecond):
+		t.Fatal("fallback poll did not claim the due retry")
+	}
+}
diff --git a/backend/internal/repository/refresh_token_cache_test.go b/backend/internal/repository/refresh_token_cache_test.go
new file mode 100644
index 000000000..c745a58c4
--- /dev/null
+++ b/backend/internal/repository/refresh_token_cache_test.go
@@ -0,0 +1,75 @@
+//go:build unit
+
+package repository
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/alicebob/miniredis/v2"
+	"github.com/redis/go-redis/v9"
+	"github.com/stretchr/testify/require"
+)
+
+func newRefreshTokenCacheForTest(t *testing.T) *refreshTokenCache {
+	t.Helper()
+	mr := miniredis.RunT(t)
+	rdb := redis.NewClient(&redis.Options{Addr: mr.Addr()})
+	t.Cleanup(func() { _ = rdb.Close() })
+	return &refreshTokenCache{rdb: rdb}
+}
+
+type consumeResult struct {
+	data *service.RefreshTokenData
+	err  error
+}
+
+// 同一个 refresh token 被并发消费时，只能有一个调用成功。
+func TestRefreshTokenCacheConsumeIsAtomic(t *testing.T) {
+	cache := newRefreshTokenCacheForTest(t)
+	ctx := context.Background()
+
+	require.NoError(t, cache.StoreRefreshToken(ctx, "hash-1", &service.RefreshTokenData{
+		UserID:   7,
+		FamilyID: "family-1",
+	}, time.Minute))
+
+	const workers = 16
+	results := make(chan consumeResult, workers)
+	start := make(chan struct{})
+	var wg sync.WaitGroup
+	for i := 0; i < workers; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			<-start
+			data, err := cache.ConsumeRefreshToken(ctx, "hash-1")
+			results <- consumeResult{data: data, err: err}
+		}()
+	}
+	close(start)
+	wg.Wait()
+	close(results)
+
+	successes, notFound := 0, 0
+	for result := range results {
+		switch {
+		case result.err == nil:
+			successes++
+			require.Equal(t, int64(7), result.data.UserID)
+		case errors.Is(result.err, service.ErrRefreshTokenNotFound):
+			notFound++
+		default:
+			t.Fatalf("unexpected consume error: %v", result.err)
+		}
+	}
+	require.Equal(t, 1, successes)
+	require.Equal(t, workers-1, notFound)
+
+	_, err := cache.GetRefreshToken(ctx, "hash-1")
+	require.ErrorIs(t, err, service.ErrRefreshTokenNotFound)
+}
diff --git a/backend/internal/repository/refresh_token_rotation_miniredis_test.go b/backend/internal/repository/refresh_token_rotation_miniredis_test.go
new file mode 100644
index 000000000..c26861e9c
--- /dev/null
+++ b/backend/internal/repository/refresh_token_rotation_miniredis_test.go
@@ -0,0 +1,141 @@
+package repository
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/Wei-Shaw/sub2api/internal/config"
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/alicebob/miniredis/v2"
+	"github.com/redis/go-redis/v9"
+	"github.com/stretchr/testify/require"
+)
+
+type rotationUserRepo struct {
+	service.UserRepository
+	user *service.User
+}
+
+func (r *rotationUserRepo) GetByID(context.Context, int64) (*service.User, error) {
+	copy := *r.user
+	return &copy, nil
+}
+
+type rotationBarrierCache struct {
+	service.RefreshTokenCache
+	wg sync.WaitGroup
+}
+
+func (c *rotationBarrierCache) GetRefreshToken(ctx context.Context, hash string) (*service.RefreshTokenData, error) {
+	data, err := c.RefreshTokenCache.GetRefreshToken(ctx, hash)
+	c.wg.Done()
+	c.wg.Wait()
+	return data, err
+}
+
+type rotationFailingConsumeCache struct{ service.RefreshTokenCache }
+
+func (c *rotationFailingConsumeCache) ConsumeRefreshToken(context.Context, string) (*service.RefreshTokenData, error) {
+	return nil, errors.New("cache unavailable")
+}
+
+func rotationService(cache service.RefreshTokenCache, user *service.User) *service.AuthService {
+	cfg := &config.Config{JWT: config.JWTConfig{Secret: "rotation-fixture-secret", AccessTokenExpireMinutes: 60, RefreshTokenExpireDays: 7}}
+	return service.NewAuthService(nil, &rotationUserRepo{user: user}, nil, cache, cfg, nil, nil, nil, nil, nil, nil, nil, nil)
+}
+
+func TestRefreshTokenRotationServiceUsesAtomicMiniredis(t *testing.T) {
+	mr := miniredis.RunT(t)
+	rdb := redis.NewClient(&redis.Options{Addr: mr.Addr()})
+	defer func() { _ = rdb.Close() }()
+	cache := NewRefreshTokenCache(rdb)
+	user := &service.User{ID: 71, Email: "rotation@example.invalid", Status: service.StatusActive, TokenVersion: 1, TokenVersionResolved: true}
+	svc := rotationService(cache, user)
+	pair, err := svc.GenerateTokenPair(t.Context(), user, "fixture-family")
+	require.NoError(t, err)
+	barrier := &rotationBarrierCache{RefreshTokenCache: cache}
+	const workers = 8
+	barrier.wg.Add(workers)
+	concurrentService := rotationService(barrier, user)
+	results := make(chan error, workers)
+	for i := 0; i < workers; i++ {
+		go func() {
+			_, err := concurrentService.RefreshTokenPair(t.Context(), pair.RefreshToken)
+			results <- err
+		}()
+	}
+	succeeded := 0
+	for i := 0; i < workers; i++ {
+		select {
+		case err := <-results:
+			if err == nil {
+				succeeded++
+			} else {
+				require.ErrorIs(t, err, service.ErrRefreshTokenInvalid)
+			}
+		case <-time.After(5 * time.Second):
+			t.Fatal("concurrent refresh did not finish")
+		}
+	}
+	require.Equal(t, 1, succeeded)
+	_, err = svc.RefreshTokenPair(t.Context(), pair.RefreshToken)
+	require.ErrorIs(t, err, service.ErrRefreshTokenInvalid)
+}
+
+func TestRefreshTokenRotationPrechecksAndCacheFailure(t *testing.T) {
+	for _, scenario := range []string{"expired", "disabled", "version", "family", "consume failure", "cancelled"} {
+		t.Run(scenario, func(t *testing.T) {
+			mr := miniredis.RunT(t)
+			rdb := redis.NewClient(&redis.Options{Addr: mr.Addr()})
+			defer func() { _ = rdb.Close() }()
+			cache := NewRefreshTokenCache(rdb)
+			user := &service.User{ID: 72, Status: service.StatusActive, TokenVersion: 1, TokenVersionResolved: true}
+			svc := rotationService(cache, user)
+			pair, err := svc.GenerateTokenPair(t.Context(), user, "fixture-family")
+			require.NoError(t, err)
+			sum := sha256.Sum256([]byte(pair.RefreshToken))
+			hash := hex.EncodeToString(sum[:])
+			ctx := t.Context()
+			want := service.ErrRefreshTokenInvalid
+			switch scenario {
+			case "expired":
+				data, err := cache.GetRefreshToken(ctx, hash)
+				require.NoError(t, err)
+				data.ExpiresAt = time.Now().Add(-time.Second)
+				require.NoError(t, cache.StoreRefreshToken(ctx, hash, data, time.Minute))
+				want = service.ErrRefreshTokenExpired
+			case "disabled":
+				user.Status = "disabled"
+				want = service.ErrUserNotActive
+			case "version":
+				user.TokenVersion++
+				want = service.ErrTokenRevoked
+			case "family":
+				require.NoError(t, cache.DeleteTokenFamily(ctx, "fixture-family"))
+			case "consume failure":
+				svc = rotationService(&rotationFailingConsumeCache{RefreshTokenCache: cache}, user)
+				want = service.ErrServiceUnavailable
+			case "cancelled":
+				cancelCtx, cancel := context.WithCancel(ctx)
+				cancel()
+				ctx = cancelCtx
+				want = service.ErrServiceUnavailable
+			}
+			result, err := svc.RefreshTokenPair(ctx, pair.RefreshToken)
+			require.ErrorIs(t, err, want)
+			require.Nil(t, result)
+			if scenario == "consume failure" || scenario == "cancelled" {
+				_, err := cache.GetRefreshToken(t.Context(), hash)
+				require.NoError(t, err, "failed consumption must not issue or destroy a token")
+			} else {
+				_, err := cache.GetRefreshToken(t.Context(), hash)
+				require.ErrorIs(t, err, service.ErrRefreshTokenNotFound)
+			}
+		})
+	}
+}
