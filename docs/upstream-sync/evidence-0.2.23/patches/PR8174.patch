+	require.NotNil(t, events[0].Response)
+	require.NotNil(t, events[0].Response.Usage)
+	assert.Equal(t, 6, events[0].Response.Usage.CacheCreationInputTokens)
+	assert.Equal(t, 16, events[0].Response.Usage.InputTokens)
+}
