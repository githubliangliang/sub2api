diff --git a/backend/internal/service/antigravity_compat_committed_no_content.go b/backend/internal/service/antigravity_compat_committed_no_content.go
new file mode 100644
index 000000000..ed91c53db
--- /dev/null
+++ b/backend/internal/service/antigravity_compat_committed_no_content.go
@@ -0,0 +1,50 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"log/slog"
+)
+
+// antigravityCompatCommittedNoContentError reports a compat stream that
+// committed HTTP 200 (pre-content keepalive) and then ended or timed out
+// without any content. The response can no longer fail over, so the client
+// retries; the handler releases the session's sticky account so that retry is
+// scheduled afresh instead of returning to the account that just failed.
+type antigravityCompatCommittedNoContentError struct {
+	msg string
+}
+
+func newAntigravityCompatCommittedNoContentError(msg string) error {
+	return &antigravityCompatCommittedNoContentError{msg: msg}
+}
+
+func (e *antigravityCompatCommittedNoContentError) Error() string { return e.msg }
+
+// IsAntigravityCompatCommittedNoContent reports whether err is a compat stream
+// that committed its response and then produced no content.
+func IsAntigravityCompatCommittedNoContent(err error) bool {
+	var target *antigravityCompatCommittedNoContentError
+	return errors.As(err, &target)
+}
+
+// ReleaseStickySessionAfterCommittedNoContent removes the session's sticky
+// binding when err is a committed no-content compat stream and the session is
+// still bound to accountID. Only this session is affected: the account is not
+// cooled or excluded for anyone else. Returns true when a binding was removed.
+func (s *GatewayService) ReleaseStickySessionAfterCommittedNoContent(ctx context.Context, groupID *int64, sessionHash string, accountID int64, err error) bool {
+	if sessionHash == "" || accountID <= 0 || s.cache == nil || !IsAntigravityCompatCommittedNoContent(err) {
+		return false
+	}
+	gid := derefGroupID(groupID)
+	bound, getErr := s.cache.GetSessionAccountID(ctx, gid, sessionHash)
+	if getErr != nil || bound != accountID {
+		return false
+	}
+	if delErr := s.cache.DeleteSessionAccountID(ctx, gid, sessionHash); delErr != nil {
+		slog.Warn("antigravity_compat_sticky_release_failed", "group_id", gid, "account_id", accountID, "error", delErr)
+		return false
+	}
+	slog.Info("antigravity_compat_sticky_released", "group_id", gid, "account_id", accountID, "reason", err.Error())
+	return true
+}
diff --git a/backend/internal/service/antigravity_compat_committed_no_content_test.go b/backend/internal/service/antigravity_compat_committed_no_content_test.go
new file mode 100644
index 000000000..c7887840a
--- /dev/null
+++ b/backend/internal/service/antigravity_compat_committed_no_content_test.go
@@ -0,0 +1,98 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net/http"
+	"testing"
+	"time"
+
+	"github.com/Wei-Shaw/sub2api/internal/config"
+	"github.com/stretchr/testify/require"
+)
+
+// runCompatStreamToEnd drives the compat stream handler with an upstream that
+// sends nothing and closes after closeAfter.
+func runCompatStreamToEnd(t *testing.T, keepaliveInterval, maxWait, closeAfter time.Duration) error {
+	t.Helper()
+	svc := newAntigravityCompatService(config.GatewayConfig{
+		MaxLineSize: defaultMaxLineSize, StreamDataIntervalTimeout: 30, StreamKeepaliveInterval: 0,
+	}, nil)
+	c, _ := newAntigravityCompatContext(http.MethodPost, "/v1/responses", nil)
+	reader, pipeWriter := io.Pipe()
+	defer func() { _ = reader.Close() }()
+	resp := &http.Response{StatusCode: http.StatusOK, Body: reader}
+	done := make(chan error, 1)
+	go func() {
+		_, err := svc.handleAntigravityCompatStreamWithKeepaliveInterval(
+			c, resp, time.Now(), "gemini-4-hydrogen-high",
+			newAntigravityResponsesStreamAdapter("gemini-4-hydrogen-high"), "test", keepaliveInterval, maxWait,
+		)
+		done <- err
+	}()
+	time.Sleep(closeAfter)
+	_ = pipeWriter.Close()
+	select {
+	case err := <-done:
+		return err
+	case <-time.After(2 * time.Second):
+		t.Fatal("compat stream handler did not return")
+		return nil
+	}
+}
+
+func TestAntigravityCompatEmptyStreamAfterKeepaliveIsCommittedNoContent(t *testing.T) {
+	err := runCompatStreamToEnd(t, 10*time.Millisecond, time.Second, 50*time.Millisecond)
+	require.Error(t, err)
+	require.True(t, IsAntigravityCompatCommittedNoContent(err), "got %v", err)
+}
+
+func TestAntigravityCompatPreContentTimeoutAfterKeepaliveIsCommittedNoContent(t *testing.T) {
+	err := runCompatStreamToEnd(t, 10*time.Millisecond, 40*time.Millisecond, 200*time.Millisecond)
+	require.Error(t, err)
+	require.ErrorContains(t, err, "pre-content stream timeout")
+	require.True(t, IsAntigravityCompatCommittedNoContent(err), "got %v", err)
+}
+
+func TestAntigravityCompatEmptyStreamBeforeKeepaliveStaysFailover(t *testing.T) {
+	err := runCompatStreamToEnd(t, time.Second, 2*time.Second, 10*time.Millisecond)
+	var failoverErr *UpstreamFailoverError
+	require.True(t, errors.As(err, &failoverErr), "got %v", err)
+	require.False(t, IsAntigravityCompatCommittedNoContent(err))
+}
+
+func TestReleaseStickySessionAfterCommittedNoContent(t *testing.T) {
+	ctx := context.Background()
+	groupID := int64(10)
+	committed := &antigravityCompatCommittedNoContentError{msg: "empty Antigravity compatibility stream after keepalive"}
+
+	t.Run("unbinds the session from the account that failed", func(t *testing.T) {
+		cache := &stubGatewayCache{sessionBindings: map[string]int64{"sess": 5}}
+		svc := &GatewayService{cache: cache}
+		require.True(t, svc.ReleaseStickySessionAfterCommittedNoContent(ctx, &groupID, "sess", 5, committed))
+		_, bound := cache.sessionBindings["sess"]
+		require.False(t, bound)
+	})
+
+	t.Run("keeps a binding that already moved to another account", func(t *testing.T) {
+		cache := &stubGatewayCache{sessionBindings: map[string]int64{"sess": 6}}
+		svc := &GatewayService{cache: cache}
+		require.False(t, svc.ReleaseStickySessionAfterCommittedNoContent(ctx, &groupID, "sess", 5, committed))
+		require.Equal(t, int64(6), cache.sessionBindings["sess"])
+	})
+
+	t.Run("ignores other errors", func(t *testing.T) {
+		cache := &stubGatewayCache{sessionBindings: map[string]int64{"sess": 5}}
+		svc := &GatewayService{cache: cache}
+		require.False(t, svc.ReleaseStickySessionAfterCommittedNoContent(ctx, &groupID, "sess", 5, errors.New("stream data interval timeout")))
+		require.Equal(t, int64(5), cache.sessionBindings["sess"])
+	})
+
+	t.Run("no session hash is a no-op", func(t *testing.T) {
+		cache := &stubGatewayCache{sessionBindings: map[string]int64{"sess": 5}}
+		svc := &GatewayService{cache: cache}
+		require.False(t, svc.ReleaseStickySessionAfterCommittedNoContent(ctx, &groupID, "", 5, committed))
+		require.Equal(t, int64(5), cache.sessionBindings["sess"])
+	})
+}
