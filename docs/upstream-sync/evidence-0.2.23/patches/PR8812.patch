+    await toggle(wrapper, "ultrafast").trigger("click");
+
+    expect(await submit(wrapper)).toMatchObject({
+      force_openai_fast: false,
+      force_openai_ultrafast: false,
+    });
+
+    wrapper.unmount();
+  });
+});
