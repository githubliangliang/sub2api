+			ForceOpenAIFast: &falsity, ForceOpenAIUltrafast: &truth,
+		})
+
+		require.NoError(t, err)
+		require.False(t, repo.updated.ForceOpenAIFast)
+		require.True(t, repo.updated.ForceOpenAIUltrafast)
