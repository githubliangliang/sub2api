+  getLiveCapability,
+  createGroup,
+  updateGroup,
+} = vi.hoisted(() => ({
+  listGroups: vi.fn(),
+  getModelAllowlistCandidates: vi.fn(),
+  getUsageSummary: vi.fn(),
+  getCapacitySummary: vi.fn(),
+  getLiveCapability: vi.fn(),
