+// 表单提交前会调用这些子组件的 validate()，自动桩不提供该方法。
+const ValidatingFieldStub = defineComponent({
+  setup(_, { expose }) {
+    expose({ validate: () => true, resetValidation: () => undefined });
+    return () => h("div");
+  },
+});
+
+const mountView = () =>
+  mount(GroupsView, {
