+		require.NoError(t, err)
+		require.False(t, repo.updated.ForceOpenAIFast)
+		require.False(t, repo.updated.ForceOpenAIUltrafast)
+	})
+
+	t.Run("platform change clears ultrafast", func(t *testing.T) {
