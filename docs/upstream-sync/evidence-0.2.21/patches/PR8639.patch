+				require.NoError(t, err)
+				multiplier := 1.0
+				if tier == "fast" {
+					multiplier = 2
+				}
+				require.InDelta(t, 8*multiplier, cost.InputCost, 1e-10)
+				require.InDelta(t, 40*multiplier, cost.OutputCost, 1e-10)
+				require.InDelta(t, 26*multiplier, cost.CacheCreationCost, 1e-10)
