+						wantOutput *= 2
+					}
+					require.Equal(t, wantLong, usageRepo.lastLog.LongContextBillingApplied)
+					require.InDelta(t, wantInput, usageRepo.lastLog.InputCost, 1e-12)
+					require.InDelta(t, wantOutput, usageRepo.lastLog.OutputCost, 1e-12)
+				})
+			}
+		}
+	}
+}
