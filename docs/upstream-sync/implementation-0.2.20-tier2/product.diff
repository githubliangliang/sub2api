+		for _, accountType := range []string{AccountTypeOAuth, AccountTypeSetupToken, AccountTypeAPIKey} {
+			for _, tier := range []string{"", "priority"} {
+				t.Run(fmt.Sprintf("%s/%d/%s", accountType, totalInput, tier), func(t *testing.T) {
