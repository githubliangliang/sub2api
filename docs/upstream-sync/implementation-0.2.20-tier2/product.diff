+	var encoded bytes.Buffer
+	_ = encoded.WriteByte('[')
+	for i, item := range result {
+		if i > 0 {
+			_ = encoded.WriteByte(',')
+		}
+		_, _ = encoded.Write(item)
+	}
+	_ = encoded.WriteByte(']')
+	return sjson.SetRawBytes(body, "input", encoded.Bytes())
+}
