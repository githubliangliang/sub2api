  "backend-race.txt": "cd backend && go test -race -tags=unit ./internal/service ./internal/repository ./internal/handler ./internal/service/openai_ws_v2 -run 'TestGroupDeletion|TestModerationSaveAndGroupDelete|TestContentModerationUpdateConfigRejectsGroup|TestOpenAIResponsesWebSocket_(GroupRate|KeyMoved|FailedKeyRefresh)|TestRefreshOpenAIWSTurnBilling|TestOpenAIWSTurn|OAuthWebSearch|HTTPThinkingSignature|StructuredInput|ConvertedResponsesInputString|GPT61Sol.*(LongContext|UsesCredential|Exemption)|ModelLongContextExemption|TestHandleCCStreamingFromAnthropic|CachedContentNotFound|OtherForbidden|QuotaForAccountSkips|ThirdPartyAPIKey429|Google.*(Error|Classified)|RequestScoped|GeminiFlashPromotion|GeminiFlashCatalog|ImageUsage|ParseUsage' -count=1",
