+	r.Use(func(c *gin.Context) { statisticsContext(c, "accounts.stats.read") })
+	r.Use(h.ScopedAdminKeyAccounts)
+	r.POST("/api/v1/admin/accounts/today-stats/batch", h.GetBatchTodayStats)
