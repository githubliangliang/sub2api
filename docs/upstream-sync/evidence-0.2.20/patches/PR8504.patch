diff --git a/frontend/src/utils/__tests__/registrationEmailBlacklist.spec.ts b/frontend/src/utils/__tests__/registrationEmailBlacklist.spec.ts
new file mode 100644
index 000000000..12deea054
--- /dev/null
+++ b/frontend/src/utils/__tests__/registrationEmailBlacklist.spec.ts
@@ -0,0 +1,41 @@
+import { describe, expect, it } from 'vitest'
+import {
+  mergeIntoBlacklist,
+  normalizeBlacklistEmail,
+  parseBlacklistInput
+} from '../registrationEmailBlacklist'
+
+describe('registrationEmailBlacklist', () => {
+  it('normalizes addresses the same way as the backend', () => {
+    expect(normalizeBlacklistEmail('  Alice@Gmail.COM ')).toBe('alice@gmail.com')
+    expect(normalizeBlacklistEmail('user@example.com.')).toBe('user@example.com')
+    expect(normalizeBlacklistEmail('a.b+tag@googlemail.com')).toBe('a.b+tag@googlemail.com')
+    expect(normalizeBlacklistEmail('@gmail.com')).toBeNull()
+    expect(normalizeBlacklistEmail('user@')).toBeNull()
+    expect(normalizeBlacklistEmail('a@b@gmail.com')).toBeNull()
+    expect(normalizeBlacklistEmail('user@localhost')).toBeNull()
+    expect(normalizeBlacklistEmail('user@bad_domain.com')).toBeNull()
+    expect(normalizeBlacklistEmail(`${'x'.repeat(65)}@gmail.com`)).toBeNull()
+    expect(normalizeBlacklistEmail('a\u0085b@gmail.com')).toBeNull()
+    expect(normalizeBlacklistEmail(`${'用'.repeat(21)}@example.com`)).toBe(`${'用'.repeat(21)}@example.com`)
+    expect(normalizeBlacklistEmail(`${'用'.repeat(22)}@example.com`)).toBeNull()
+    expect(normalizeBlacklistEmail('İvan@Example.com')).toBe('İvan@example.com')
+  })
+
+  it('splits pasted text and separates invalid tokens', () => {
+    expect(parseBlacklistInput('A@gmail.com, b@gmail.com；c@gmail.com\n\nbad a@gmail.com')).toEqual({
+      valid: ['a@gmail.com', 'b@gmail.com', 'c@gmail.com'],
+      invalid: ['bad'],
+      duplicates: 1
+    })
+    expect(parseBlacklistInput('   ')).toEqual({ valid: [], invalid: [], duplicates: 0 })
+  })
+
+  it('prepends only new addresses and counts duplicates', () => {
+    expect(mergeIntoBlacklist(['x@gmail.com'], ['y@gmail.com', 'x@gmail.com', 'z@gmail.com'])).toEqual({
+      list: ['y@gmail.com', 'z@gmail.com', 'x@gmail.com'],
+      added: ['y@gmail.com', 'z@gmail.com'],
+      duplicates: 1
+    })
+  })
+})
diff --git a/frontend/src/utils/registrationEmailBlacklist.ts b/frontend/src/utils/registrationEmailBlacklist.ts
new file mode 100644
index 000000000..4d38c7539
--- /dev/null
+++ b/frontend/src/utils/registrationEmailBlacklist.ts
@@ -0,0 +1,106 @@
+// Exact registration email blacklist input helpers. Validation follows the
+// backend (NormalizeRegistrationEmailBlacklistEntry): trim, drop the domain root
+// dot, local part ≤ 64 UTF-8 bytes, whole address ≤ 254 UTF-8 bytes. Only ASCII
+// letters are lowercased here; the backend applies full lowercasing on save and
+// returns the stored form.
+
+const TOKEN_SPLIT_RE = /[\s,，;；]+/
+const DOMAIN_PATTERN =
+  /^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$/
+const LOCAL_MAX_BYTES = 64
+const EMAIL_MAX_BYTES = 254
+const utf8 = new TextEncoder()
+
+function utf8Length(value: string): number {
+  return utf8.encode(value).length
+}
+
+function hasControlChar(value: string): boolean {
+  for (let i = 0; i < value.length; i++) {
+    const code = value.charCodeAt(i)
+    if (code <= 0x1f || (code >= 0x7f && code <= 0x9f)) {
+      return true
+    }
+  }
+  return false
+}
+
+/** Returns the normalized address, or null when the token is not a valid email. */
+export function normalizeBlacklistEmail(raw: string): string | null {
+  const value = String(raw ?? '').trim().replace(/[A-Z]+/g, (letters) => letters.toLowerCase())
+  const at = value.indexOf('@')
+  if (at <= 0) {
+    return null
+  }
+  const local = value.slice(0, at)
+  const domain = value.slice(at + 1).replace(/\.+$/, '')
+  if (!domain || domain.includes('@')) {
+    return null
+  }
+  if (utf8Length(local) > LOCAL_MAX_BYTES || /\s/.test(local) || hasControlChar(local)) {
+    return null
+  }
+  if (!DOMAIN_PATTERN.test(domain)) {
+    return null
+  }
+  const email = `${local}@${domain}`
+  return utf8Length(email) > EMAIL_MAX_BYTES ? null : email
+}
+
+export interface ParsedBlacklistInput {
+  /** Normalized, de-duplicated addresses in input order. */
+  valid: string[]
+  /** Raw tokens that are not valid addresses. */
+  invalid: string[]
+  /** Tokens dropped because an earlier token normalized to the same address. */
+  duplicates: number
+}
+
+/** Splits pasted text on whitespace, commas and semicolons into addresses. */
+export function parseBlacklistInput(input: string): ParsedBlacklistInput {
+  const valid: string[] = []
+  const invalid: string[] = []
+  const seen = new Set<string>()
+  let duplicates = 0
+  for (const token of String(input ?? '').split(TOKEN_SPLIT_RE)) {
+    if (!token) {
+      continue
+    }
+    const email = normalizeBlacklistEmail(token)
+    if (!email) {
+      invalid.push(token)
+      continue
+    }
+    if (seen.has(email)) {
+      duplicates++
+      continue
+    }
+    seen.add(email)
+    valid.push(email)
+  }
+  return { valid, invalid, duplicates }
+}
+
+export interface MergeBlacklistResult {
+  list: string[]
+  added: string[]
+  duplicates: number
+}
+
+/** Prepends addresses not already in the list; existing order is kept. */
+export function mergeIntoBlacklist(existing: string[], incoming: string[]): MergeBlacklistResult {
+  const present = new Set(existing)
+  const added: string[] = []
+  for (const email of incoming) {
+    if (present.has(email)) {
+      continue
+    }
+    present.add(email)
+    added.push(email)
+  }
+  return {
+    list: [...added, ...existing],
+    added,
+    duplicates: incoming.length - added.length
+  }
+}
