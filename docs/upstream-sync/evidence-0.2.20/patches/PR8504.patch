+func TestAdminService_BatchDisableUsers_EmptyAndErrors(t *testing.T) {
+	repo := &emailBlacklistUserRepoStub{userRepoStub: &userRepoStub{}}
+	svc := &adminServiceImpl{userRepo: repo}
