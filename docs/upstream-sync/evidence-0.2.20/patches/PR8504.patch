+func TestAdminService_BatchDisableUsers_InvalidatesOnlyDisabledUsers(t *testing.T) {
+	repo := &emailBlacklistUserRepoStub{userRepoStub: &userRepoStub{}, disabled: []int64{7}}
+	invalidator := &authCacheInvalidatorStub{}
