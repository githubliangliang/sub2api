+func TestMCPDispatchPreservesOwnershipAndRedactsExistingSecrets(t *testing.T) {
+	inner := gin.New()
+	inner.GET("/api/v1/keys/:id", DispatchAuth(false), func(c *gin.Context) {
+		subject, ok := middleware.GetAuthSubjectFromContext(c)
+		require.True(t, ok)
