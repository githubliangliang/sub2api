+	MCPScopeAdmin          = "admin"
+	MCPOAuthScope          = "mcp"
+	MCPOAuthGrantLimit     = 20
+	MCPOAuthAccessLifetime = 10 * time.Minute
+	MCPOAuthCodeLifetime   = 5 * time.Minute
+	MCPOAuthGrantLifetime  = 30 * 24 * time.Hour
