+	ReadOnly      *bool                  `json:"read_only"`
+}
+
+type MCPOAuthConsent struct {
+	ClientID    string `json:"client_id"`
+	ClientName  string `json:"client_name"`
+	RedirectURI string `json:"redirect_uri"`
+	Resource    string `json:"resource"`
