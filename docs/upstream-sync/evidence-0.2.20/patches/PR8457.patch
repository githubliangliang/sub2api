new file mode 100644
index 000000000..5acaa741d
--- /dev/null
+++ b/backend/internal/pkg/httputil/body_read_error.go
@@ -0,0 +1,194 @@
+package httputil
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+	"os"
+	"strings"
+	"syscall"
+	"time"
+
+	"go.uber.org/zap"
+)
+
+// Stable, payload-free labels for request body read failures.
+const (
+	RequestBodyReadErrorMaxBytes                   = "max_bytes"
+	RequestBodyReadErrorTimeout                    = "read_timeout"
+	RequestBodyReadErrorClientDisconnect           = "client_disconnect"
+	RequestBodyReadErrorTruncated                  = "truncated_body"
+	RequestBodyReadErrorDecodeContentEncoding      = "decode_content_encoding"
+	RequestBodyReadErrorUnsupportedContentEncoding = "unsupported_content_encoding"
+	RequestBodyReadErrorTransport                  = "transport"
+	RequestBodyReadErrorIO                         = "io_read"
+)
+
+// StatusClientClosedRequest is the non-standard status recorded when the client
+// goes away before the server responds.
+const StatusClientClosedRequest = 499
+
+// RequestBodyReadError annotates a failed request body read with progress
+// counters. It never carries request content.
+type RequestBodyReadError struct {
+	Err       error
+	BytesRead int64
+	Elapsed   time.Duration
+}
+
+func (e *RequestBodyReadError) Error() string { return e.Err.Error() }
+
+func (e *RequestBodyReadError) Unwrap() error { return e.Err }
+
+// RequestBodyReadFailure is the response and the payload-free diagnostics for a
+// failed request body read.
+type RequestBodyReadFailure struct {
+	Kind    string
+	Status  int
+	Message string
+	// MaxBytesLimit is set when Kind is RequestBodyReadErrorMaxBytes.
+	MaxBytesLimit int64
+
+	contentLength   int64
+	contentEncoding string
+	protocol        string
+	chunked         bool
+	bytesRead       int64
+	elapsed         time.Duration
+}
+
+// DescribeRequestBodyReadFailure classifies a request body read error. Timeouts
+// and client disconnects get their own status codes so they are not reported
+// as malformed requests; other failures keep the generic 400 response.
+func DescribeRequestBodyReadFailure(req *http.Request, err error) RequestBodyReadFailure {
+	failure := RequestBodyReadFailure{
+		Kind:            classifyRequestBodyReadError(req, err),
+		contentLength:   -1,
+		contentEncoding: "identity",
+		bytesRead:       -1,
+	}
+	if req != nil {
+		failure.contentLength = req.ContentLength
+		failure.contentEncoding = RequestContentEncodingCategory(req.Header.Get("Content-Encoding"))
+		failure.protocol = req.Proto
+		failure.chunked = len(req.TransferEncoding) > 0
+	}
+	var readErr *RequestBodyReadError
+	if errors.As(err, &readErr) {
+		failure.bytesRead = readErr.BytesRead
+		failure.elapsed = readErr.Elapsed
+	}
+
+	switch failure.Kind {
+	case RequestBodyReadErrorMaxBytes:
+		var maxErr *http.MaxBytesError
+		if errors.As(err, &maxErr) {
+			failure.MaxBytesLimit = maxErr.Limit
+		}
+		failure.Status = http.StatusRequestEntityTooLarge
+		failure.Message = "Request body is too large"
+	case RequestBodyReadErrorTimeout:
+		failure.Status = http.StatusRequestTimeout
+		failure.Message = "Timed out reading request body"
+	case RequestBodyReadErrorClientDisconnect:
+		failure.Status = StatusClientClosedRequest
+		failure.Message = "Client closed the connection before the request body was received"
+	default:
+		failure.Status = http.StatusBadRequest
+		failure.Message = "Failed to read request body"
+	}
+	return failure
+}
+
+// LogFields returns diagnostics that never include request content or error
+// text, which may embed peer addresses or decoder input.
+func (f RequestBodyReadFailure) LogFields() []zap.Field {
+	fields := []zap.Field{
+		zap.String("error_kind", f.Kind),
+		zap.Int("status", f.Status),
+		zap.String("protocol", f.protocol),
+		zap.String("content_encoding", f.contentEncoding),
+		zap.Int64("content_length", f.contentLength),
+		zap.Bool("chunked", f.chunked),
+	}
+	if f.bytesRead >= 0 {
+		fields = append(fields,
+			zap.Int64("bytes_read", f.bytesRead),
+			zap.Int64("read_ms", f.elapsed.Milliseconds()),
+		)
+	}
+	return fields
+}
+
+func classifyRequestBodyReadError(req *http.Request, err error) string {
+	if err == nil {
+		return RequestBodyReadErrorIO
+	}
+	var maxErr *http.MaxBytesError
+	if errors.As(err, &maxErr) {
+		return RequestBodyReadErrorMaxBytes
+	}
+	lower := strings.ToLower(err.Error())
+	if strings.Contains(lower, "decode content-encoding") {
+		if strings.Contains(lower, "unsupported content-encoding") {
+			return RequestBodyReadErrorUnsupportedContentEncoding
+		}
+		return RequestBodyReadErrorDecodeContentEncoding
+	}
+	// Check timeouts first: on HTTP/1 a read deadline also cancels the request
+	// context, which would otherwise look like a client disconnect.
+	if IsRequestBodyReadTimeout(err) {
+		return RequestBodyReadErrorTimeout
+	}
+	if requestBodyClientGone(req, err, lower) {
+		return RequestBodyReadErrorClientDisconnect
+	}
+	// HTTP/2 reports an END_STREAM that arrives before Content-Length bytes
+	// with "request declared a Content-Length of N but only wrote M bytes".
+	if errors.Is(err, io.ErrUnexpectedEOF) || strings.Contains(lower, "request declared a content-length") {
+		return RequestBodyReadErrorTruncated
+	}
+	var netErr net.Error
+	if errors.As(err, &netErr) {
+		return RequestBodyReadErrorTransport
+	}
+	return RequestBodyReadErrorIO
+}
+
+// IsRequestBodyReadTimeout reports whether a body read failed because a read
+// deadline expired (for example WithBodyReadTimeout's per-read deadline).
+func IsRequestBodyReadTimeout(err error) bool {
+	var netErr net.Error
+	return errors.Is(err, os.ErrDeadlineExceeded) || (errors.As(err, &netErr) && netErr.Timeout())
+}
+
+func requestBodyClientGone(req *http.Request, err error, lowerErr string) bool {
+	if errors.Is(err, context.Canceled) || errors.Is(err, syscall.ECONNRESET) || errors.Is(err, syscall.EPIPE) {
+		return true
+	}
+	// HTTP/2 reports a closed client connection with this message.
+	if strings.Contains(lowerErr, "client disconnected") {
+		return true
+	}
+	// net/http cancels the request context when the connection fails, so an
+	// unexpected EOF with a canceled context is a disconnect, not a short body.
+	return req != nil && errors.Is(req.Context().Err(), context.Canceled)
+}
+
+// RequestContentEncodingCategory maps Content-Encoding to a bounded label.
+func RequestContentEncodingCategory(value string) string {
+	switch strings.ToLower(strings.TrimSpace(value)) {
+	case "", "identity":
+		return "identity"
+	case "gzip", "x-gzip":
+		return "gzip"
+	case "zstd":
+		return "zstd"
+	case "deflate":
+		return "deflate"
+	default:
+		return "other"
+	}
+}
diff --git a/backend/internal/pkg/httputil/body_read_error_test.go b/backend/internal/pkg/httputil/body_read_error_test.go
new file mode 100644
index 000000000..a75261655
--- /dev/null
+++ b/backend/internal/pkg/httputil/body_read_error_test.go
@@ -0,0 +1,124 @@
+package httputil
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"os"
+	"strings"
+	"syscall"
+	"testing"
+	"testing/iotest"
+	"time"
+
+	"go.uber.org/zap"
+	"go.uber.org/zap/zaptest/observer"
+)
+
+func TestReadRequestBodyWithPreallocReportsProgressOnReadError(t *testing.T) {
+	reader := io.MultiReader(bytes.NewReader([]byte("partial")), iotest.ErrReader(io.ErrUnexpectedEOF))
+	req := &http.Request{Body: io.NopCloser(reader), ContentLength: 100, Header: make(http.Header)}
+
+	got, err := ReadRequestBodyWithPrealloc(req)
+
+	var readErr *RequestBodyReadError
+	if got != nil || !errors.As(err, &readErr) || !errors.Is(err, io.ErrUnexpectedEOF) {
+		t.Fatalf("read error lost its cause or progress: body=%q err=%v", got, err)
+	}
+	if readErr.BytesRead != int64(len("partial")) || readErr.Elapsed < 0 {
+		t.Fatalf("unexpected progress: bytes=%d elapsed=%s", readErr.BytesRead, readErr.Elapsed)
+	}
+}
+
+func TestDescribeRequestBodyReadFailure(t *testing.T) {
+	canceledCtx, cancel := context.WithCancel(context.Background())
+	cancel()
+	deadlineErr := &net.OpError{Op: "read", Net: "tcp", Err: os.ErrDeadlineExceeded}
+	resetErr := &net.OpError{Op: "read", Net: "tcp", Err: os.NewSyscallError("read", syscall.ECONNRESET)}
+
+	tests := []struct {
+		name       string
+		ctx        context.Context
+		err        error
+		wantKind   string
+		wantStatus int
+	}{
+		// net/http cancels the request context on an HTTP/1 read timeout too;
+		// the timeout must still win over the disconnect classification.
+		{"http1 read deadline", canceledCtx, &RequestBodyReadError{Err: deadlineErr}, RequestBodyReadErrorTimeout, http.StatusRequestTimeout},
+		{"http2 read deadline", context.Background(), fmt.Errorf("%w", os.ErrDeadlineExceeded), RequestBodyReadErrorTimeout, http.StatusRequestTimeout},
+		{"http1 disconnect mid body", canceledCtx, &RequestBodyReadError{Err: io.ErrUnexpectedEOF}, RequestBodyReadErrorClientDisconnect, StatusClientClosedRequest},
+		{"connection reset", context.Background(), resetErr, RequestBodyReadErrorClientDisconnect, StatusClientClosedRequest},
+		{"http2 client disconnected", context.Background(), errors.New("client disconnected"), RequestBodyReadErrorClientDisconnect, StatusClientClosedRequest},
+		{"truncated body", context.Background(), &RequestBodyReadError{Err: io.ErrUnexpectedEOF}, RequestBodyReadErrorTruncated, http.StatusBadRequest},
+		{"http2 short body", context.Background(), errors.New("request declared a Content-Length of 10 but only wrote 3 bytes"), RequestBodyReadErrorTruncated, http.StatusBadRequest},
+		{"max bytes", context.Background(), &RequestBodyReadError{Err: &http.MaxBytesError{Limit: 64}}, RequestBodyReadErrorMaxBytes, http.StatusRequestEntityTooLarge},
+		{"decode", context.Background(), errors.New(`decode Content-Encoding "gzip": unexpected EOF`), RequestBodyReadErrorDecodeContentEncoding, http.StatusBadRequest},
+		{"unsupported encoding", context.Background(), errors.New(`decode Content-Encoding "br": unsupported Content-Encoding`), RequestBodyReadErrorUnsupportedContentEncoding, http.StatusBadRequest},
+		{"other", context.Background(), errors.New("boom"), RequestBodyReadErrorIO, http.StatusBadRequest},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			req, err := http.NewRequestWithContext(tc.ctx, http.MethodPost, "/v1/messages", nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			got := DescribeRequestBodyReadFailure(req, tc.err)
+			if got.Kind != tc.wantKind || got.Status != tc.wantStatus || got.Message == "" {
+				t.Fatalf("got kind=%q status=%d message=%q, want kind=%q status=%d", got.Kind, got.Status, got.Message, tc.wantKind, tc.wantStatus)
+			}
+		})
+	}
+
+	if got := DescribeRequestBodyReadFailure(nil, &http.MaxBytesError{Limit: 64}); got.MaxBytesLimit != 64 {
+		t.Fatalf("max bytes limit not reported: %d", got.MaxBytesLimit)
+	}
+	if got := DescribeRequestBodyReadFailure(nil, errors.New("boom")); got.Message != "Failed to read request body" {
+		t.Fatalf("generic failures must keep the stable message, got %q", got.Message)
+	}
+}
+
+func TestRequestBodyReadFailureLogFieldsArePayloadFree(t *testing.T) {
+	req, err := http.NewRequest(http.MethodPost, "/v1/messages", strings.NewReader("secret-payload-marker"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	req.ContentLength = 4096
+	req.Header.Set("Content-Encoding", "zstd")
+	readErr := &RequestBodyReadError{
+		Err:       &net.OpError{Op: "read", Net: "tcp", Err: errors.New("10.0.0.1 secret-payload-marker")},
+		BytesRead: 1024,
+		Elapsed:   1500 * time.Millisecond,
+	}
+
+	core, logs := observer.New(zap.WarnLevel)
+	zap.New(core).Warn("read request body failed", DescribeRequestBodyReadFailure(req, readErr).LogFields()...)
+
+	entries := logs.All()
+	if len(entries) != 1 {
+		t.Fatalf("expected one log entry, got %d", len(entries))
+	}
+	fields := entries[0].ContextMap()
+	want := map[string]any{
+		"error_kind":       RequestBodyReadErrorTransport,
+		"status":           int64(http.StatusBadRequest),
+		"content_encoding": "zstd",
+		"content_length":   int64(4096),
+		"bytes_read":       int64(1024),
+		"read_ms":          int64(1500),
+		"chunked":          false,
+		"protocol":         "HTTP/1.1",
+	}
+	for key, value := range want {
+		if fields[key] != value {
+			t.Fatalf("field %s = %#v, want %#v (all: %v)", key, fields[key], value, fields)
+		}
+	}
+	if strings.Contains(fmt.Sprint(fields), "secret-payload-marker") || strings.Contains(fmt.Sprint(fields), "10.0.0.1") {
+		t.Fatalf("log fields leaked error text: %v", fields)
+	}
+}
