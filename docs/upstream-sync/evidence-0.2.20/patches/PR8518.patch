+				Concurrency: 1,
+				Credentials: map[string]any{
+					"api_key":       "sk-test",
+					"base_url":      "https://example.com",
+					"model_mapping": map[string]any{"client-alias": "gpt-5"},
+				},
+				Extra: map[string]any{"use_responses_api": true},
+			}
+			ctx, release := httputil.WithRequestBodyMemoryBudget(context.Background(), httputil.NewBodyMemoryBudget(1))
+			t.Cleanup(release)
+			c, _ := gin.CreateTestContext(httptest.NewRecorder())
+			c.Request = httptest.NewRequest(http.MethodPost, "/openai/v1/responses", nil).WithContext(ctx)
+			SetOpenAIClientTransport(c, OpenAIClientTransportHTTP)
+
+			result, err := svc.Forward(ctx, c, account, []byte(tt.body))
+			require.ErrorIs(t, err, httputil.ErrRequestBodyMemoryBudget)
+			require.Nil(t, result)
+			require.Nil(t, upstream.lastReq, "overload must not fall back to unbudgeted serialization or forwarding")
+		})
+	}
+}
+
+func TestOpenAIRequestPatches_EffectiveEditsOwnOutput(t *testing.T) {
+	for _, patches := range [][]openAIRequestPatch{
+		{{path: "model", value: "mapped"}},
+		{{path: "previous_response_id", delete: true}},
+		{{path: "model", value: "mapped"}, {path: "reasoning.effort", value: "none"}, {path: "previous_response_id", delete: true}},
+	} {
+		t.Run(fmt.Sprintf("%d_edits_%s", len(patches), patches[0].path), func(t *testing.T) {
+			body := []byte(`{"model":"old","reasoning":{"effort":"low"},"previous_response_id":"resp_1","opaque":"` + strings.Repeat("payload", 4096) + `"}`)
+			view := requestViewWithPatches(body, patches)
+			got, err := view.ApplyPatches(context.Background())
+			require.NoError(t, err)
+			snapshot := bytes.Clone(got)
+
+			// The borrowed source may be released or reused after ApplyPatches returns.
+			for i := range body {
+				body[i] = 'x'
+			}
+			require.Equal(t, snapshot, got)
+			got[0] = '!'
+			require.Equal(t, bytes.Repeat([]byte{'x'}, len(body)), body)
+		})
+	}
+}
+
+type failingOpenAIRequestPatchValue struct {
+	err error
+}
+
+func (v failingOpenAIRequestPatchValue) MarshalJSON() ([]byte, error) {
+	return nil, v.err
+}
+
+func TestOpenAIRequestPatches_PropagateValueErrorWithoutPartialOutput(t *testing.T) {
+	valueErr := errors.New("request patch encoding failed")
+	for _, priorEdits := range []int{0, 1, 2} {
+		t.Run(fmt.Sprintf("after_%d_edits", priorEdits), func(t *testing.T) {
+			body := []byte(`{"model":"old","instructions":"original","input":[]}`)
+			original := bytes.Clone(body)
+			view := newOpenAIRequestView(body)
+			for i := 0; i < priorEdits; i++ {
+				view.MarkPatchSet("model", fmt.Sprintf("mapped-%d", i))
+			}
+			view.MarkPatchSet("instructions", failingOpenAIRequestPatchValue{err: valueErr})
+
+			got, err := view.ApplyPatches(context.Background())
+			require.ErrorIs(t, err, valueErr)
+			require.Nil(t, got)
+			require.Equal(t, original, body)
+		})
+	}
+}
+
+func TestOpenAIRequestPatches_ConcurrentImmutableInput(t *testing.T) {
+	body := []byte(`{"model":"old","reasoning":{"effort":"low"},"previous_response_id":"resp_1","opaque":"` + strings.Repeat("payload", 4096) + `"}`)
+	original := bytes.Clone(body)
+	t.Cleanup(func() {
+		require.Equal(t, original, body)
+	})
+	for worker := 0; worker < 8; worker++ {
+		t.Run(fmt.Sprintf("worker_%d", worker), func(t *testing.T) {
+			t.Parallel()
+			patches := []openAIRequestPatch{
+				{path: "model", value: fmt.Sprintf("model-%d", worker)},
+				{path: "reasoning.effort", value: "none"},
+				{path: "previous_response_id", delete: true},
+			}
+			want, err := applyOpenAIRequestPatchesSequential(body, patches)
+			require.NoError(t, err)
+			for i := 0; i < 16; i++ {
+				view := requestViewWithPatches(body, patches)
+				got, err := view.ApplyPatches(context.Background())
+				require.NoError(t, err)
+				require.Equal(t, want, got)
+				got[0] = '!'
+			}
+		})
+	}
+}
diff --git a/backend/internal/service/openai_responses_orphan_precheck.go b/backend/internal/service/openai_responses_orphan_precheck.go
new file mode 100644
index 000000000..ec9084988
--- /dev/null
+++ b/backend/internal/service/openai_responses_orphan_precheck.go
@@ -0,0 +1,133 @@
+package service
+
+import (
+	"bytes"
+	"encoding/json"
+
+	"github.com/tidwall/gjson"
+)
+
+// openAIResponsesInputMayNeedOrphanCleanup only proves that cleanup is a no-op.
+// Possible outputs still use the existing decoder and sanitizer, including its
+// named standalone outputs, call/id fallback and item-reference rules. All byte
+// spans below borrow the immutable request only for this synchronous call.
+func openAIResponsesInputMayNeedOrphanCleanup(body []byte) bool {
+	// Use Get directly: Parse(...).Get(...) differs from GetBytes on malformed
+	// prefixes, where the old gate can still find an input and invoke the decoder.
+	input := gjson.Get(openAIWSPayloadStringView(body), "input")
+	if !input.IsArray() {
+		return false
+	}
+	if !json.Valid(body) {
+		// Preserve the existing decoder's malformed/trailing-JSON error path.
+		return true
+	}
+	if body[skipOpenAIWSJSONSpace(body, 0)] != '{' || input.Index <= 0 || input.Index > len(body)-len(input.Raw) {
+		return true
+	}
+
+	hasPreviousResponseID := false
+	inputSeen, previousResponseIDSeen := false, false
+	if !visitOpenAIResponsesOrphanPrecheckFields(body, func(key, value []byte) bool {
+		switch string(key) {
+		case `"input"`:
+			if inputSeen {
+				return false
+			}
+			inputSeen = true
+		case `"previous_response_id"`:
+			if previousResponseIDSeen {
+				return false
+			}
+			previousResponseIDSeen = true
+			if value[0] == '"' {
+				if bytes.IndexByte(value, '\\') >= 0 {
+					return false
+				}
+				hasPreviousResponseID = len(bytes.TrimSpace(value[1:len(value)-1])) != 0
+			}
+		}
+		return true
+	}) {
+		// GJSON selects first duplicate keys; encoding/json selects the last.
+		// Escaped keys and duplicate relevant keys conservatively use the latter.
+		return true
+	}
+	if hasPreviousResponseID {
+		return false
+	}
+
+	rawInput := body[input.Index : input.Index+len(input.Raw)]
+	for i := 1; ; {
+		i = skipOpenAIWSJSONSpace(rawInput, i)
+		if rawInput[i] == ']' {
+			return false
+		}
+		start := i
+		switch rawInput[i] {
+		case '{', '[', '"':
+			i = skipOpenAIWSJSONValue(rawInput, i)
+		default:
+			// The shared object-value scanner stops at '}', whereas scalar
+			// array members end at ']'. No scalar item can contain a tool output.
+			for rawInput[i] != ',' && rawInput[i] != ']' {
+				i++
+			}
+		}
+		if rawInput[start] == '{' {
+			typeSeen := false
+			if !visitOpenAIResponsesOrphanPrecheckFields(rawInput[start:i], func(key, value []byte) bool {
+				if string(key) != `"type"` {
+					return true
+				}
+				if typeSeen {
+					return false
+				}
+				typeSeen = true
+				if value[0] != '"' {
+					return true
+				}
+				if bytes.IndexByte(value, '\\') >= 0 {
+					return false
+				}
+				return !isCodexToolCallOutputItemType(parseRawJSONView(value).Str)
+			}) {
+				return true
+			}
+		}
+		i = skipOpenAIWSJSONSpace(rawInput, i)
+		if rawInput[i] == ',' {
+			i++
+		}
+	}
+}
+
+// visitOpenAIResponsesOrphanPrecheckFields visits an already-validated object
+// without materializing unrelated strings (including large escaped content).
+// Escaped keys are deliberately left to the full decoder rather than decoded
+// into potentially request-sized temporary strings here.
+func visitOpenAIResponsesOrphanPrecheckFields(object []byte, visit func(key, value []byte) bool) bool {
+	i := skipOpenAIWSJSONSpace(object, 0) + 1
+	for {
+		i = skipOpenAIWSJSONSpace(object, i)
+		if object[i] == '}' {
+			return true
+		}
+		keyStart := i
+		keyEnd := scanOpenAIWSJSONString(object, i)
+		key := object[keyStart:keyEnd]
+		if bytes.IndexByte(key, '\\') >= 0 {
+			return false
+		}
+		i = skipOpenAIWSJSONSpace(object, keyEnd) + 1 // Valid JSON guarantees ':'.
+		valueStart := skipOpenAIWSJSONSpace(object, i)
+		i = skipOpenAIWSJSONValue(object, valueStart)
+		if !visit(key, bytes.TrimSpace(object[valueStart:i])) {
+			return false
+		}
+		i = skipOpenAIWSJSONSpace(object, i)
+		if object[i] == ',' {
+			i++
+		}
+	}
+}
diff --git a/backend/internal/service/openai_responses_orphan_precheck_benchmark_test.go b/backend/internal/service/openai_responses_orphan_precheck_benchmark_test.go
new file mode 100644
index 000000000..73c1c2c6c
--- /dev/null
+++ b/backend/internal/service/openai_responses_orphan_precheck_benchmark_test.go
@@ -0,0 +1,49 @@
+package service
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/tidwall/gjson"
+)
+
+// These measure only the orphan-cleanup stage, not the complete gateway. B/op
+// is cumulative allocated memory per operation, not retained heap or RSS.
+func BenchmarkOpenAIResponsesOrphanPrecheck(b *testing.B) {
+	for _, size := range []int{64 << 10, 1 << 20, 4 << 20} {
+		for _, previous := range []bool{false, true} {
+			name := fmt.Sprintf("bytes_%d/previous_%t", size, previous)
+			bodyText := `{"input":[{"type":"message","content":"` + strings.Repeat(`text\n`, size/6) + `"}]`
+			if previous {
+				bodyText += `,"previous_response_id":"resp_1"`
+			}
+			body := []byte(bodyText + `}`)
+			b.Run(name+"/before", func(b *testing.B) {
+				b.ReportAllocs()
+				b.SetBytes(int64(len(body)))
+				for b.Loop() {
+					if gjson.GetBytes(body, "input").IsArray() {
+						var request map[string]any
+						if err := decodeOpenAIJSONUseNumber(body, &request); err != nil {
+							b.Fatal(err)
+						}
+						input, _ := request["input"].([]any)
+						if sanitizeOpenAIResponsesOrphanToolOutputs(request, input, previous) {
+							b.Fatal("unexpected cleanup")
+						}
+					}
+				}
+			})
+			b.Run(name+"/after", func(b *testing.B) {
+				b.ReportAllocs()
+				b.SetBytes(int64(len(body)))
+				for b.Loop() {
+					if openAIResponsesInputMayNeedOrphanCleanup(body) {
+						b.Fatal("unexpected cleanup candidate")
+					}
+				}
+			})
+		}
+	}
+}
diff --git a/backend/internal/service/openai_responses_orphan_precheck_test.go b/backend/internal/service/openai_responses_orphan_precheck_test.go
