+			require.Error(t, parsed.ReplaceBody(parsed.Body.Bytes()))
+			require.Nil(t, parsed.Body.parsed)
+			require.NoError(t, parsed.ReplaceBody([]byte(`{"model":"recovered","messages":[2]}`)))
