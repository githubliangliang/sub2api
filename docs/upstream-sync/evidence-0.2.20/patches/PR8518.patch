+	detached, releaseDetached, err := DetachRequestBodyMemory(ctx, 40)
+	if err != nil {
+		t.Fatal(err)
+	}
+	release() // The handler returns while the detached work still runs.
+	if budget.used != 40 {
+		t.Fatalf("detached body must stay reserved: %d", budget.used)
+	}
