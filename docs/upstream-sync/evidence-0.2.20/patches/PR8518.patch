+	}
+	if _, _, err := DetachRequestBodyMemory(ctx, 101); !errors.Is(err, ErrRequestBodyMemoryBudget) {
+		t.Fatalf("want capacity error, got %v", err)
+	}
+	if budget.used != 50 {
