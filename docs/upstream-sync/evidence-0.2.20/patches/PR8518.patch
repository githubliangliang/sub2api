@@ -0,0 +1,58 @@
+package service
+
+import (
+	"bufio"
+	"errors"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/Wei-Shaw/sub2api/internal/config"
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/require"
+)
+
+// Upstreams behind a custom base_url can stream a line that never ends. Every
+// Gemini stream reader must stop at the configured line limit instead of
+// buffering it, and must not forward a truncated prefix.
+func TestGeminiStreamsRejectOversizedUpstreamLines(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	cfg := &config.Config{Gateway: config.GatewayConfig{MaxLineSize: 256}}
+	svc := &GeminiMessagesCompatService{cfg: cfg}
+	oversized := `data: {"candidates":[{"content":{"parts":[{"text":"` + strings.Repeat("x", 4096)
+
+	run := map[string]func(c *gin.Context, resp *http.Response) error{
+		"native": func(c *gin.Context, resp *http.Response) error {
+			_, err := svc.handleNativeStreamingResponse(c, resp, time.Now(), false, &Account{ID: 1}, "")
+			return err
+		},
+		"messages": func(c *gin.Context, resp *http.Response) error {
+			_, err := svc.handleStreamingResponse(c, resp, time.Now(), "gemini-2.5-pro")
+			return err
+		},
+		"chat_completions": func(c *gin.Context, resp *http.Response) error {
+			_, err := svc.handleChatCompletionsStreamingResponseFromGemini(c, resp, time.Now(), "gemini-2.5-pro", false, false)
+			return err
+		},
+		"collector": func(_ *gin.Context, resp *http.Response) error {
+			_, _, _, err := collectGeminiSSEObserved(cfg, resp.Body, false, nil)
+			return err
+		},
+	}
+	for name, fn := range run {
+		t.Run(name, func(t *testing.T) {
+			w := httptest.NewRecorder()
+			c, _ := gin.CreateTestContext(w)
+			c.Request = httptest.NewRequest(http.MethodPost, "/v1beta/models/gemini-2.5-pro:streamGenerateContent", nil)
+			resp := &http.Response{StatusCode: http.StatusOK, Header: http.Header{}, Body: io.NopCloser(strings.NewReader(oversized))}
+
+			err := fn(c, resp)
+			require.Error(t, err)
+			require.True(t, errors.Is(err, bufio.ErrTooLong), "got %v", err)
+			require.NotContains(t, w.Body.String(), "xxxx")
+		})
+	}
+}
diff --git a/backend/internal/service/gemini_text_delta_test.go b/backend/internal/service/gemini_text_delta_test.go
new file mode 100644
index 000000000..d8a7bcf50
--- /dev/null
+++ b/backend/internal/service/gemini_text_delta_test.go
@@ -0,0 +1,62 @@
+package service
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+// legacyComputeGeminiTextDelta is the previous string-concatenating
+// implementation, kept as the oracle for the storage-only change.
+func legacyComputeGeminiTextDelta(seen, incoming string) (delta, newSeen string) {
+	incoming = strings.TrimSuffix(incoming, "\u0000")
+	if incoming == "" {
+		return "", seen
+	}
+	if strings.HasPrefix(incoming, seen) {
+		return strings.TrimPrefix(incoming, seen), incoming
+	}
+	if strings.HasPrefix(seen, incoming) {
+		return "", seen
+	}
+	return incoming, seen + incoming
+}
+
+func TestGeminiTextDeltaMatchesLegacy(t *testing.T) {
+	sequences := [][]string{
+		{"Hel", "Hello", "Hello, wor", "Hello, world"},   // cumulative
+		{"Hel", "lo", ", wor", "ld"},                     // incremental
+		{"The", " cat", "The", " sat"},                   // delta equal to an emitted prefix
+		{"abc", "abc", "ab", "abcd", "x"},                // duplicate, rewind, extend, diverge
+		{"", "\u0000", "a\u0000", "ab", "", "abc\u0000"}, // empty and NUL-terminated chunks
+		{"{\"a\":", "{\"a\":1", "}", "{\"a\":1}"},        // tool args mixing modes
+		{"多字节", "多字节文本", "😀", "多字节文本😀继续"},                // non-ASCII
+	}
+	for _, seq := range sequences {
+		var state geminiTextDelta
+		legacySeen := ""
+		for i, chunk := range seq {
+			wantDelta, newSeen := legacyComputeGeminiTextDelta(legacySeen, chunk)
+			legacySeen = newSeen
+			require.Equal(t, wantDelta, state.next(chunk), "sequence %q chunk %d", seq, i)
+			require.Equal(t, legacySeen, state.seen.String(), "sequence %q chunk %d", seq, i)
+		}
+		state.reset()
+		require.Equal(t, "", state.seen.String())
+		require.Equal(t, "fresh", state.next("fresh"))
+	}
+}
+
+func TestGeminiTextDeltaIncrementalAllocationsStayLinear(t *testing.T) {
+	chunk := strings.Repeat("x", 100)
+	const chunks = 2000
+	allocs := testing.AllocsPerRun(5, func() {
+		var state geminiTextDelta
+		for i := 0; i < chunks; i++ {
+			_ = state.next(chunk)
+		}
+	})
+	// Concatenation allocates once per chunk; amortized growth needs O(log n).
+	require.Less(t, allocs, float64(100), "allocs per stream: %v", allocs)
+}
