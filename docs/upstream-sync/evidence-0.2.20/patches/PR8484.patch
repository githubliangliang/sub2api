diff --git a/backend/internal/service/openai_images_stream_limit_error_test.go b/backend/internal/service/openai_images_stream_limit_error_test.go
new file mode 100644
index 000000000..a563227fa
--- /dev/null
+++ b/backend/internal/service/openai_images_stream_limit_error_test.go
@@ -0,0 +1,243 @@
+package service
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
