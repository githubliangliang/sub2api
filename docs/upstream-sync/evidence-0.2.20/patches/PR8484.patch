+		{"native_responses_buffered", false, func(resp *http.Response, c *gin.Context) (int, error) {
+			r, e := openai.handleResponsesBufferedFromNativeAnthropic(resp, c, "m", "m", "m", nil, time.Now(), mapping)
+			if r == nil {
+				return 0, e
