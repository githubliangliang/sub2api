+				svc := &OpenAIGatewayService{cfg: cfg}
+				var err error
+				if oauth {
+					_, _, _, _, err = svc.handleOpenAIImagesOAuthStreamingResponse(resp, c, time.Now(), "b64_json", "image_generation", "gpt-image-2")
