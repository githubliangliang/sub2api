+				wantErr = ErrRequestBodyMemoryBudget
+			case "concat_overload":
+				budget.limit = 20000
+				payload = bytes.Repeat([]byte{'x'}, 8192)
+				wantErr = ErrRequestBodyMemoryBudget
+			case "normalization_overload":
+				budget.limit = 600
+				payload = []byte(`{"input":"` + strings.Repeat("\x00", 100) + `"}`)
+				wantErr = ErrRequestBodyMemoryBudget
+			case "normalization_size":
+				maxNormalized = 64
+			case "invalid_gzip":
+				encoding = "gzip"
+			case "invalid_zstd":
+				encoding = "zstd"
+			case "read_error":
+				wantErr = io.ErrUnexpectedEOF
+			case "cancellation":
+				wantErr = context.Canceled
+			}
+			req := newRequestWithBody(t, payload, encoding).WithContext(ctx)
+			req.ContentLength = -1
+			if name == "normalization_overload" {
+				req.ContentLength = int64(len(payload))
+			}
+			if name == "read_error" {
+				req.Body = io.NopCloser(io.MultiReader(bytes.NewReader(payload), requestBodyBudgetReaderFunc(func([]byte) (int, error) {
+					return 0, io.ErrUnexpectedEOF
+				})))
+			}
+			if name == "cancellation" {
+				reader := bytes.NewReader(payload)
+				req.Body = io.NopCloser(requestBodyBudgetReaderFunc(func(p []byte) (int, error) {
+					n, err := reader.Read(p)
+					cancel()
+					return n, err
+				}))
+			}
+			got, err := ReadLenientJSONRequestBodyWithPrealloc(req, maxNormalized)
+			if got != nil || err == nil || wantErr != nil && !errors.Is(err, wantErr) {
+				t.Fatalf("expected failed read (%v), got len=%d err=%v", wantErr, len(got), err)
+			}
+			if used := requestBodyBudgetUsed(budget); used != 100 {
+				t.Fatalf("failed read retained temporary storage or refunded another owner: %d", used)
+			}
+		})
+	}
+}
+
+func TestRequestBodyMemoryBudgetPreservesBorrowedPrereadAllocation(t *testing.T) {
+	budget := NewBodyMemoryBudget(4096)
+	ctx, release := WithRequestBodyMemoryBudget(context.Background(), budget)
+	defer release()
+	payload := []byte(`{"input":"hello` + "\x00" + `"}`)
+	req := newRequestWithBody(t, payload, "").WithContext(ctx)
+	original, err := ReadRequestBodyWithPrealloc(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	req.Body = NewPrereadBody(original)
+	if _, err := ReadLenientJSONRequestBodyWithPrealloc(req, 1); err == nil {
+		t.Fatal("oversize preread body was accepted")
+	}
+	if used := requestBodyBudgetUsed(budget); used != int64(cap(original)) {
+		t.Fatalf("failed normalization refunded borrowed storage: %d", used)
+	}
+	normalized, err := ReadLenientJSONRequestBodyWithPrealloc(req, 4096)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if used := requestBodyBudgetUsed(budget); used != int64(cap(original)+cap(normalized)) {
+		t.Fatalf("original and normalized bodies remain live but only %d bytes are charged", used)
+	}
+	again, err := ReadRequestBodyWithPrealloc(req)
+	if err != nil || !bytes.Equal(again, payload) || &again[0] != &original[0] {
+		t.Fatal("normalization changed the borrowed preread body")
+	}
+	if used := requestBodyBudgetUsed(budget); used != int64(cap(original)+cap(normalized)) {
+		t.Fatalf("preread fast path changed the budget: %d", used)
+	}
+}
diff --git a/backend/internal/pkg/httputil/read_timeout.go b/backend/internal/pkg/httputil/read_timeout.go
new file mode 100644
index 000000000..9c74c450a
--- /dev/null
+++ b/backend/internal/pkg/httputil/read_timeout.go
@@ -0,0 +1,156 @@
+package httputil
+
+import (
+	"bufio"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+	"sync/atomic"
+	"time"
+)
+
+// WithBodyReadTimeout bounds each socket read while receiving a body. It does
+// not set a whole-request deadline or limit the duration of an SSE response.
+func WithBodyReadTimeout(next http.Handler, timeout time.Duration) http.Handler {
+	if timeout <= 0 {
+		return next
+	}
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Body != nil && r.Body != http.NoBody {
+			body := &bodyReadTimeout{ReadCloser: r.Body, controller: http.NewResponseController(w), timeout: timeout}
+			r.Body = body
+			if r.ProtoMajor == 1 {
+				writer := &bodyDrainTimeoutWriter{ResponseWriter: w, body: body}
+				defer func() {
+					if !writer.hijacked.Load() {
+						// net/http closes its original body after ServeHTTP returns,
+						// bypassing our Read and Close methods.
+						body.startDrain()
+					}
+				}()
+				next.ServeHTTP(writer, r)
+				return
+			}
+		}
+		next.ServeHTTP(w, r)
+	})
+}
+
+type bodyReadTimeout struct {
+	io.ReadCloser
+	controller *http.ResponseController
+	timeout    time.Duration
+	finished   atomic.Bool
+	failed     atomic.Bool
+}
+
+func (r *bodyReadTimeout) Read(p []byte) (int, error) {
+	err := r.controller.SetReadDeadline(time.Now().Add(r.timeout))
+	if err != nil && !errors.Is(err, http.ErrNotSupported) {
+		return 0, err
+	}
+	n, readErr := r.ReadCloser.Read(p)
+	if errors.Is(readErr, io.EOF) {
+		r.finished.Store(true)
+	} else if readErr != nil {
+		r.failed.Store(true)
+	}
+	if readErr == nil || errors.Is(readErr, io.EOF) {
+		_ = r.controller.SetReadDeadline(time.Time{})
+	}
+	// Keep a failed read's deadline: net/http may drain an unread HTTP/1 body
+	// after the handler returns. Clearing a timeout here could block that drain.
+	return n, readErr
+}
+
+func (r *bodyReadTimeout) Close() error {
+	armed := r.startDrain()
+	err := r.ReadCloser.Close()
+	if err == nil {
+		r.finished.Store(true)
+	} else {
+		r.failed.Store(true)
+	}
+	r.finishDrain(armed)
+	return err
+}
+
+func (r *bodyReadTimeout) startDrain() bool {
+	if r.finished.Load() || r.failed.Load() {
+		return false
+	}
+	return r.controller.SetReadDeadline(time.Now().Add(r.timeout)) == nil
+}
+
+func (r *bodyReadTimeout) finishDrain(armed bool) {
+	if armed && !r.failed.Load() {
+		_ = r.controller.SetReadDeadline(time.Time{})
+	}
+}
+
+// HTTP/1 can drain an unread request body during its first response write or
+// flush as well as after the handler returns. These reads use net/http's original
+// body, so guard the response operations too. HTTP/2 has no such implicit drain.
+type bodyDrainTimeoutWriter struct {
+	http.ResponseWriter
+	body       *bodyReadTimeout
+	hijacked   atomic.Bool
+	fullDuplex atomic.Bool
+}
+
+func (w *bodyDrainTimeoutWriter) Unwrap() http.ResponseWriter { return w.ResponseWriter }
+
+func (w *bodyDrainTimeoutWriter) startDrain() bool {
+	return !w.fullDuplex.Load() && w.body.startDrain()
+}
+
+func (w *bodyDrainTimeoutWriter) Write(p []byte) (int, error) {
+	armed := w.startDrain()
+	defer w.body.finishDrain(armed)
+	return w.ResponseWriter.Write(p)
+}
+
+func (w *bodyDrainTimeoutWriter) WriteString(s string) (int, error) {
+	armed := w.startDrain()
+	defer w.body.finishDrain(armed)
+	return io.WriteString(w.ResponseWriter, s)
+}
+
+func (w *bodyDrainTimeoutWriter) WriteHeader(status int) {
+	armed := w.startDrain()
+	defer w.body.finishDrain(armed)
+	w.ResponseWriter.WriteHeader(status)
+}
+
+func (w *bodyDrainTimeoutWriter) FlushError() error {
+	armed := w.startDrain()
+	defer w.body.finishDrain(armed)
+	return http.NewResponseController(w.ResponseWriter).Flush()
+}
+
+func (w *bodyDrainTimeoutWriter) Flush() { _ = w.FlushError() }
+
+func (w *bodyDrainTimeoutWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	conn, rw, err := http.NewResponseController(w.ResponseWriter).Hijack()
+	if err == nil {
+		w.hijacked.Store(true)
+		_ = conn.SetReadDeadline(time.Time{})
+	}
+	return conn, rw, err
+}
+
+func (w *bodyDrainTimeoutWriter) EnableFullDuplex() error {
+	if err := http.NewResponseController(w.ResponseWriter).EnableFullDuplex(); err != nil {
+		return err
+	}
+	w.fullDuplex.Store(true)
+	return nil
+}
+
+func (w *bodyDrainTimeoutWriter) CloseNotify() <-chan bool {
+	if notifier, ok := w.ResponseWriter.(http.CloseNotifier); ok { //nolint:staticcheck // Gin's ResponseWriter still requires legacy CloseNotify forwarding.
+		return notifier.CloseNotify()
+	}
+	return make(chan bool)
+}
diff --git a/backend/internal/pkg/httputil/read_timeout_test.go b/backend/internal/pkg/httputil/read_timeout_test.go
new file mode 100644
index 000000000..6d10bc9e6
--- /dev/null
+++ b/backend/internal/pkg/httputil/read_timeout_test.go
@@ -0,0 +1,261 @@
+package httputil
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestBodyReadTimeoutReleasesStalledUpload(t *testing.T) {
+	readDone := make(chan error, 1)
+	srv := httptest.NewServer(WithBodyReadTimeout(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		_, err := io.ReadAll(r.Body)
+		readDone <- err
+	}), 100*time.Millisecond))
+	defer srv.Close()
+	conn, err := net.Dial("tcp", srv.Listener.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() { _ = conn.Close() }()
+	if _, err := io.WriteString(conn, "POST / HTTP/1.1\r\nHost: test\r\nContent-Length: 1024\r\n\r\nx"); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case err := <-readDone:
+		var timeout net.Error
+		if !errors.As(err, &timeout) || !timeout.Timeout() {
+			t.Fatalf("want upload timeout, got %v", err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("stalled upload retained handler")
+	}
+}
+
+func TestBodyReadTimeoutClosesStalledHTTP1Connection(t *testing.T) {
+	closed := make(chan struct{}, 1)
+	handlerDone := make(chan struct{})
+	srv := httptest.NewUnstartedServer(WithWriteTimeout(WithBodyReadTimeout(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if _, err := io.ReadAll(r.Body); err != nil {
+			w.WriteHeader(http.StatusBadRequest)
+		}
+		close(handlerDone)
+	}), 100*time.Millisecond), 100*time.Millisecond))
+	srv.Config.ConnState = func(_ net.Conn, state http.ConnState) {
+		if state == http.StateClosed {
+			select {
+			case closed <- struct{}{}:
+			default:
+			}
+		}
+	}
+	srv.Start()
+	defer srv.Close()
+	conn, err := net.Dial("tcp", srv.Listener.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() { _ = conn.Close() }()
+	// Keep the remainder small enough for net/http's automatic post-handler
+	// drain. Clearing the failed read's deadline would strand that drain even
+	// though the application handler itself has already returned.
+	if _, err := io.WriteString(conn, "POST / HTTP/1.1\r\nHost: test\r\nContent-Length: 1024\r\n\r\nx"); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-handlerDone:
+	case <-time.After(2 * time.Second):
+		t.Fatal("stalled upload retained handler")
+	}
+	select {
+	case <-closed:
+	case <-time.After(2 * time.Second):
+		t.Fatal("timed-out upload retained the connection while net/http drained the unread body")
+	}
+}
+
+func TestBodyReadTimeoutClosesRejectedHTTP1Upload(t *testing.T) {
+	for _, partialRead := range []bool{false, true} {
+		for _, response := range []string{"buffered", "flush", "large_write", "close_body"} {
+			name := response + "/unread"
+			if partialRead {
+				name = response + "/partial_read"
+			}
+			t.Run(name, func(t *testing.T) {
+				handlerDone := make(chan error, 1)
+				closed := make(chan struct{}, 1)
+				handler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+					if partialRead {
+						if _, err := io.ReadFull(r.Body, make([]byte, 1)); err != nil {
+							handlerDone <- err
+							return
+						}
+					}
+					ctx, release := WithRequestBodyMemoryBudget(r.Context(), NewBodyMemoryBudget(1))
+					defer release()
+					_, err := ReadRequestBodyWithPrealloc(r.WithContext(ctx))
+					if !errors.Is(err, ErrRequestBodyMemoryBudget) {
+						handlerDone <- errors.New("request did not exhaust its body budget")
+						return
+					}
+					w.WriteHeader(http.StatusServiceUnavailable)
+					switch response {
+					case "flush":
+						_ = http.NewResponseController(w).Flush()
+					case "large_write":
+						_, _ = w.Write([]byte(strings.Repeat("x", 8192)))
+					case "close_body":
+						_ = r.Body.Close()
+					default:
+						_, _ = io.WriteString(w, "busy")
+					}
+					handlerDone <- nil
+				})
+				srv := httptest.NewUnstartedServer(WithWriteTimeout(WithBodyReadTimeout(handler, 50*time.Millisecond), 100*time.Millisecond))
+				srv.Config.ConnState = func(_ net.Conn, state http.ConnState) {
+					if state == http.StateClosed {
+						select {
+						case closed <- struct{}{}:
+						default:
+						}
+					}
+				}
+				srv.Start()
+				defer srv.Close()
+				conn, err := net.Dial("tcp", srv.Listener.Addr().String())
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer func() { _ = conn.Close() }()
+				if _, err := io.WriteString(conn, "POST / HTTP/1.1\r\nHost: test\r\nContent-Length: 1024\r\n\r\nx"); err != nil {
+					t.Fatal(err)
+				}
+				select {
+				case err := <-handlerDone:
+					if err != nil {
+						t.Fatal(err)
+					}
+				case <-time.After(2 * time.Second):
+					t.Fatal("rejection blocked while writing the response or closing the body")
+				}
+				select {
+				case <-closed:
+				case <-time.After(2 * time.Second):
+					t.Fatal("rejected upload retained its HTTP/1 connection")
+				}
+			})
+		}
+	}
+}
+
+func TestBodyReadTimeoutDoesNotLimitHTTP1ResponseLifetime(t *testing.T) {
+	for _, readAll := range []bool{false, true} {
+		name := "implicit_drain"
+		if readAll {
+			name = "complete_body"
+		}
+		t.Run(name, func(t *testing.T) {
+			handlerErr := make(chan error, 1)
+			srv := httptest.NewServer(WithBodyReadTimeout(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				var err error
+				if readAll {
+					_, err = io.Copy(io.Discard, r.Body)
+				} else {
+					_, err = io.ReadFull(r.Body, make([]byte, 1))
+				}
+				if err != nil {
+					handlerErr <- err
+					return
+				}
+				_, _ = io.WriteString(w, "first\n")
+				if err = http.NewResponseController(w).Flush(); err != nil {
+					handlerErr <- err
+					return
+				}
+				// The first flush implicitly consumes any unread body. Its read
+				// deadline must not cancel the response during upstream thinking.
+				timer := time.NewTimer(300 * time.Millisecond)
+				defer timer.Stop()
+				select {
+				case <-r.Context().Done():
+					handlerErr <- r.Context().Err()
+					return
+				case <-timer.C:
+				}
+				_, err = io.WriteString(w, "last\n")
+				handlerErr <- err
+			}), 100*time.Millisecond))
+			defer srv.Close()
+			client := srv.Client()
+			client.Timeout = 3 * time.Second
+			resp, err := client.Post(srv.URL, "application/json", strings.NewReader(`{"input":"hello"}`))
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer func() { _ = resp.Body.Close() }()
+			body, err := io.ReadAll(resp.Body)
+			if err != nil || string(body) != "first\nlast\n" {
+				t.Fatalf("response was truncated: %q, %v", body, err)
+			}
+			if err := <-handlerErr; err != nil {
+				t.Fatalf("response lifetime was limited by the upload deadline: %v", err)
+			}
+		})
+	}
+}
+
+func TestBodyReadTimeoutHTTP2DoesNotCancelOtherStreams(t *testing.T) {
+	readDone := make(chan error, 1)
+	srv := httptest.NewUnstartedServer(WithBodyReadTimeout(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path == "/slow" {
+			_, err := io.ReadAll(r.Body)
+			readDone <- err
+			return
+		}
+		w.WriteHeader(http.StatusNoContent)
+	}), 100*time.Millisecond))
+	srv.EnableHTTP2 = true
+	srv.StartTLS()
+	defer srv.Close()
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	reader, writer := io.Pipe()
+	defer func() { _ = writer.Close() }()
+	slow, _ := http.NewRequestWithContext(ctx, http.MethodPost, srv.URL+"/slow", reader)
+	clientDone := make(chan struct{})
+	go func() {
+		defer close(clientDone)
+		resp, err := srv.Client().Do(slow)
+		if err == nil {
+			_ = resp.Body.Close()
+		}
+	}()
+	defer func() {
+		cancel()
+		_ = writer.Close()
+		<-clientDone
+	}()
+	select {
+	case err := <-readDone:
+		if err == nil {
+			t.Fatal("stalled HTTP/2 upload accepted")
+		}
+	case <-ctx.Done():
+		t.Fatal("stalled HTTP/2 upload retained handler")
+	}
+	fast, _ := http.NewRequestWithContext(ctx, http.MethodGet, srv.URL+"/fast", nil)
+	resp, err := srv.Client().Do(fast)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() { _ = resp.Body.Close() }()
+	if resp.ProtoMajor != 2 || resp.StatusCode != http.StatusNoContent {
+		t.Fatalf("other stream failed: %s %s", resp.Proto, resp.Status)
+	}
+}
diff --git a/backend/internal/pkg/httputil/upstream_drain.go b/backend/internal/pkg/httputil/upstream_drain.go
new file mode 100644
index 000000000..9aee08bfb
--- /dev/null
+++ b/backend/internal/pkg/httputil/upstream_drain.go
@@ -0,0 +1,73 @@
+package httputil
+
+import (
+	"context"
+	"sync"
+	"time"
+)
+
+const DefaultUpstreamDrainTimeout = 180 * time.Second
+
+type upstreamDrainKey struct{}
+type upstreamDrainPolicy struct {
+	client  context.Context
+	timeout time.Duration
+}
+
+// DetachUpstreamContext keeps billing reads alive after the client leaves. It
+// records the original cancellation signal without starting a timer or changing
+// existing construction-time release semantics. The transport owns the actual
+// attempt lifetime and installs the bounded drain when sending the request.
+func DetachUpstreamContext(ctx context.Context, timeout ...time.Duration) context.Context {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	policy := upstreamDrainPolicy{client: ctx}
+	if previous, ok := ctx.Value(upstreamDrainKey{}).(upstreamDrainPolicy); ok {
+		policy = previous
+	}
+	if len(timeout) > 0 && timeout[0] > 0 {
+		policy.timeout = timeout[0]
+	}
+	return context.WithValue(context.WithoutCancel(ctx), upstreamDrainKey{}, policy)
+}
+
+// NewUpstreamAttemptContext starts a total drain budget when the original client
+// context is cancelled. Incoming bytes do not extend this budget. Until then the
+// request may stream for arbitrarily long, and late usage remains readable
+// throughout the drain window. release must run on error or response-body close.
+func NewUpstreamAttemptContext(parent context.Context, defaultTimeout time.Duration) (context.Context, context.CancelFunc) {
+	ctx, cancel := context.WithCancel(parent)
+	policy, ok := parent.Value(upstreamDrainKey{}).(upstreamDrainPolicy)
+	if !ok || policy.client.Done() == nil {
+		return ctx, cancel
+	}
+	timeout := policy.timeout
+	if timeout <= 0 {
+		timeout = defaultTimeout
+	}
+	if timeout <= 0 {
+		timeout = DefaultUpstreamDrainTimeout
+	}
+	var mu sync.Mutex
+	var timer *time.Timer
+	closed := false
+	startDrain := func() {
+		mu.Lock()
+		defer mu.Unlock()
+		if !closed {
+			timer = time.AfterFunc(timeout, cancel)
+		}
+	}
+	stop := context.AfterFunc(policy.client, startDrain)
+	return ctx, func() {
+		stop()
+		mu.Lock()
+		closed = true
+		if timer != nil {
+			timer.Stop()
+		}
+		mu.Unlock()
+		cancel()
+	}
+}
diff --git a/backend/internal/pkg/httputil/upstream_drain_test.go b/backend/internal/pkg/httputil/upstream_drain_test.go
new file mode 100644
index 000000000..b6e6f8f9c
--- /dev/null
+++ b/backend/internal/pkg/httputil/upstream_drain_test.go
@@ -0,0 +1,54 @@
+package httputil
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestUpstreamDrainStartsOnlyAfterClientCancellation(t *testing.T) {
+	client, cancelClient := context.WithCancel(context.Background())
+	defer cancelClient()
+	upstream, release := NewUpstreamAttemptContext(DetachUpstreamContext(client), 30*time.Millisecond)
+	defer release()
+	time.Sleep(60 * time.Millisecond)
+	require.NoError(t, upstream.Err())
+	cancelClient()
+	select {
+	case <-upstream.Done():
+		t.Fatal("cancelled before late usage drain window")
+	case <-time.After(10 * time.Millisecond):
+	}
+	select {
+	case <-upstream.Done():
+		require.ErrorIs(t, upstream.Err(), context.Canceled)
+	case <-time.After(time.Second):
+		t.Fatal("drain exceeded total budget")
+	}
+}
+
+func TestUpstreamDrainOverrideAndNestedDetachKeepOriginalSignal(t *testing.T) {
+	client, cancelClient := context.WithCancel(context.Background())
+	parent := DetachUpstreamContext(DetachUpstreamContext(client, 20*time.Millisecond))
+	upstream, release := NewUpstreamAttemptContext(parent, time.Second)
+	defer release()
+	cancelClient()
+	select {
+	case <-upstream.Done():
+	case <-time.After(200 * time.Millisecond):
+		t.Fatal("nested detach lost original cancellation or override")
+	}
+}
+
+func TestUpstreamDrainReleaseDoesNotCancelCaller(t *testing.T) {
+	client, cancelClient := context.WithCancel(context.Background())
+	defer cancelClient()
+	upstream, release := NewUpstreamAttemptContext(DetachUpstreamContext(client), time.Second)
+	release()
+	release()
+	require.ErrorIs(t, upstream.Err(), context.Canceled)
+	require.NoError(t, client.Err())
+	cancelClient()
+}
diff --git a/backend/internal/pkg/httputil/write_timeout.go b/backend/internal/pkg/httputil/write_timeout.go
new file mode 100644
index 000000000..3fbdc664f
--- /dev/null
+++ b/backend/internal/pkg/httputil/write_timeout.go
@@ -0,0 +1,116 @@
+package httputil
+
+import (
+	"bufio"
+	"context"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+	"time"
+)
+
+// WithWriteTimeout bounds individual writes and flushes. Clearing the deadline
+// after each operation permits arbitrarily long upstream thinking intervals.
+// Wrapping below Gin also covers all its ResponseWriter decorators and keeps
+// HTTP/2 deadlines scoped to the individual stream.
+func WithWriteTimeout(next http.Handler, timeout time.Duration) http.Handler {
+	if timeout <= 0 {
+		return next
+	}
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		ctx, cancel := context.WithCancel(r.Context())
+		defer cancel()
+		writer := &writeTimeoutWriter{ResponseWriter: w, timeout: timeout, cancel: cancel}
+		next.ServeHTTP(writer, r.WithContext(ctx))
+	})
+}
+
+type writeTimeoutWriter struct {
+	http.ResponseWriter
+	timeout time.Duration
+	cancel  context.CancelFunc
+	err     error
+}
+
+func (w *writeTimeoutWriter) Unwrap() http.ResponseWriter { return w.ResponseWriter }
+
+func (w *writeTimeoutWriter) start() error {
+	if w.err != nil {
+		return w.err
+	}
+	err := http.NewResponseController(w.ResponseWriter).SetWriteDeadline(time.Now().Add(w.timeout))
+	if err != nil && !errors.Is(err, http.ErrNotSupported) {
+		w.fail(err)
+	}
+	return w.err
+}
+
+func (w *writeTimeoutWriter) finish() {
+	_ = http.NewResponseController(w.ResponseWriter).SetWriteDeadline(time.Time{})
+}
+
+func (w *writeTimeoutWriter) fail(err error) {
+	if err != nil {
+		w.err = err
+		w.cancel()
+	}
+}
+
+func (w *writeTimeoutWriter) Write(p []byte) (int, error) {
+	if err := w.start(); err != nil {
+		return 0, err
+	}
+	defer w.finish()
+	n, err := w.ResponseWriter.Write(p)
+	w.fail(err)
+	return n, err
+}
+
+func (w *writeTimeoutWriter) WriteString(s string) (int, error) {
+	if err := w.start(); err != nil {
+		return 0, err
+	}
+	defer w.finish()
+	n, err := io.WriteString(w.ResponseWriter, s)
+	w.fail(err)
+	return n, err
+}
+
+func (w *writeTimeoutWriter) WriteHeader(status int) {
+	if w.start() != nil {
+		return
+	}
+	defer w.finish()
+	w.ResponseWriter.WriteHeader(status)
+}
+
+func (w *writeTimeoutWriter) FlushError() error {
+	if err := w.start(); err != nil {
+		return err
+	}
+	defer w.finish()
+	err := http.NewResponseController(w.ResponseWriter).Flush()
+	w.fail(err)
+	return err
+}
+
+func (w *writeTimeoutWriter) Flush() { _ = w.FlushError() }
+
+func (w *writeTimeoutWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	return http.NewResponseController(w.ResponseWriter).Hijack()
+}
+
+func (w *writeTimeoutWriter) Push(target string, opts *http.PushOptions) error {
+	if pusher, ok := w.ResponseWriter.(http.Pusher); ok {
+		return pusher.Push(target, opts)
+	}
+	return http.ErrNotSupported
+}
+
+func (w *writeTimeoutWriter) CloseNotify() <-chan bool {
+	if notifier, ok := w.ResponseWriter.(http.CloseNotifier); ok { //nolint:staticcheck // Gin still exposes CloseNotify; preserve legacy writer compatibility.
+		return notifier.CloseNotify()
+	}
+	return make(chan bool)
+}
