+	require.NotNil(t, snap.LastAttempt)
+	require.Equal(t, "failed", snap.LastAttempt.Status)
+	require.Equal(t, "transport", snap.LastAttempt.ErrorCode)
+	require.Nil(t, snap.Scope)
