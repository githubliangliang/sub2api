@@ -0,0 +1,176 @@
+package service
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestUpdateAccountKeepsGrokCatalogManagedByDatabase(t *testing.T) {
+	freshModels := map[string]any{
+		"models":     []string{"fresh-model"},
+		"fetched_at": "2026-10-25T12:00:00Z",
+	}
+	freshMetadata := map[string]any{
+		"models": map[string]any{"fresh-model": map[string]any{"id": "fresh-model"}},
+	}
+	failedSnapshot := map[string]any{
+		"models":     []string{"fresh-model"},
+		"fetched_at": "2026-10-25T12:00:00Z",
+		"last_attempt": map[string]any{
+			"started_at":  "2026-10-25T13:00:00Z",
+			"finished_at": "2026-10-25T13:00:01Z",
+			"status":      "failed",
+			"error_code":  "transport",
+		},
+	}
+	oldModels := map[string]any{
+		"models":     []string{"old-model"},
+		"fetched_at": "2026-10-24T12:00:00Z",
+	}
+	oldMetadata := map[string]any{
+		"models": map[string]any{"old-model": map[string]any{"id": "old-model"}},
+	}
+
+	tests := []struct {
+		name         string
+		accountType  string
+		credentials  map[string]any
+		storedExtra  map[string]any
+		inputExtra   map[string]any
+		inputCreds   map[string]any
+		wantModels   any
+		wantMetadata any
+		wantBaseURL  string
+	}{
+		{
+			name:        "oauth stale form does not replace fresh snapshot or metadata",
+			accountType: AccountTypeOAuth,
+			credentials: map[string]any{"access_token": "token-keep"},
+			storedExtra: map[string]any{
+				grokObservedModelsExtraKey:    freshModels,
+				UpstreamModelMetadataExtraKey: freshMetadata,
+			},
+			inputExtra: map[string]any{
+				"grok_client_tool_cache_enabled": true,
+				grokObservedModelsExtraKey:       oldModels,
+				UpstreamModelMetadataExtraKey:    oldMetadata,
+			},
+			wantModels:   freshModels,
+			wantMetadata: freshMetadata,
+		},
+		{
+			name:        "apikey form opened without keys does not delete them",
+			accountType: AccountTypeAPIKey,
+			credentials: map[string]any{"api_key": "sk-keep", "base_url": "https://api.example.test/v1"},
+			storedExtra: map[string]any{
+				grokObservedModelsExtraKey:    freshModels,
+				UpstreamModelMetadataExtraKey: freshMetadata,
+			},
+			inputExtra: map[string]any{
+				"grok_client_tool_cache_enabled": true,
+			},
+			wantModels:   freshModels,
+			wantMetadata: freshMetadata,
+		},
+		{
+			name:        "injected catalog is ignored when the account has none",
+			accountType: AccountTypeOAuth,
+			credentials: map[string]any{"access_token": "token-keep"},
+			storedExtra: map[string]any{"note": "keep"},
+			inputExtra: map[string]any{
+				"note":                        "from-form",
+				grokObservedModelsExtraKey:    oldModels,
+				UpstreamModelMetadataExtraKey: oldMetadata,
+			},
+		},
+		{
+			name:        "failed attempt is not rolled back to an older success",
+			accountType: AccountTypeAPIKey,
+			credentials: map[string]any{"api_key": "sk-keep"},
+			storedExtra: map[string]any{
+				grokObservedModelsExtraKey:    failedSnapshot,
+				UpstreamModelMetadataExtraKey: freshMetadata,
+			},
+			inputExtra: map[string]any{
+				grokObservedModelsExtraKey:    oldModels,
+				UpstreamModelMetadataExtraKey: oldMetadata,
+			},
+			wantModels:   failedSnapshot,
+			wantMetadata: freshMetadata,
+		},
+		{
+			name:        "changing the saved endpoint keeps the old success",
+			accountType: AccountTypeOAuth,
+			credentials: map[string]any{
+				"access_token": "token-keep",
+				"base_url":     "https://old.example.test/v1",
+			},
+			storedExtra: map[string]any{
+				grokObservedModelsExtraKey:    freshModels,
+				UpstreamModelMetadataExtraKey: freshMetadata,
+			},
+			inputExtra: map[string]any{
+				grokObservedModelsExtraKey: nil,
+			},
+			inputCreds: map[string]any{
+				"base_url": "https://new.example.test/v1",
+			},
+			wantModels:   freshModels,
+			wantMetadata: freshMetadata,
+			wantBaseURL:  "https://new.example.test/v1",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			const accountID = int64(25)
+			repo := &upstreamBillingProbeAccountRepo{accounts: map[int64]*Account{
+				accountID: {
+					ID:          accountID,
+					Name:        "grok",
+					Platform:    PlatformGrok,
+					Type:        tt.accountType,
+					Status:      StatusActive,
+					Credentials: tt.credentials,
+					Extra:       tt.storedExtra,
+				},
+			}}
+
+			got, err := (&adminServiceImpl{accountRepo: repo}).UpdateAccount(context.Background(), accountID, &UpdateAccountInput{
+				Extra:       tt.inputExtra,
+				Credentials: tt.inputCreds,
+			})
+			require.NoError(t, err)
+			if tt.wantModels == nil {
+				require.NotContains(t, got.Extra, grokObservedModelsExtraKey)
+			} else {
+				require.Equal(t, tt.wantModels, got.Extra[grokObservedModelsExtraKey])
+			}
+			if tt.wantMetadata == nil {
+				require.NotContains(t, got.Extra, UpstreamModelMetadataExtraKey)
+			} else {
+				require.Equal(t, tt.wantMetadata, got.Extra[UpstreamModelMetadataExtraKey])
+			}
+			if _, ok := tt.inputExtra["grok_client_tool_cache_enabled"]; ok {
+				require.Equal(t, true, got.Extra["grok_client_tool_cache_enabled"])
+			}
+			if tt.wantBaseURL != "" {
+				require.Equal(t, tt.wantBaseURL, got.GetCredential("base_url"))
+				require.Equal(t, "token-keep", got.GetCredential("access_token"))
+				oldScope, scopeErr := NewGrokCatalogScope(accountID, tt.accountType, "https://old.example.test/v1/models")
+				require.NoError(t, scopeErr)
+				current, scopeErr := NewGrokCatalogScope(accountID, tt.accountType, "https://new.example.test/v1/models")
+				require.NoError(t, scopeErr)
+				snapshot := parseGrokObservedModels(got.Extra)
+				require.NotNil(t, snapshot)
+				snapshot.Scope = oldScope
+				diag := EvaluateGrokModelDiagnostics(got, current, snapshot, time.Date(2026, 10, 25, 18, 0, 0, 0, time.UTC))
+				require.Equal(t, "source_changed", diag.State)
+				require.Equal(t, []string{"fresh-model"}, diag.Models)
+			}
+		})
+	}
+}
diff --git a/backend/internal/service/grok_model_catalog.go b/backend/internal/service/grok_model_catalog.go
new file mode 100644
index 000000000..99f60971b
--- /dev/null
+++ b/backend/internal/service/grok_model_catalog.go
@@ -0,0 +1,310 @@
+package service
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"net/url"
+	"strconv"
+	"strings"
+	"time"
+)
+
+const (
+	grokCatalogStatusSuccess            = "success"
+	grokCatalogStatusFailed             = "failed"
+	grokCatalogStatusConfiguredFallback = "configured_fallback"
+)
+
+var (
+	errGrokCatalogInvalidResponse    = errors.New("grok catalog: invalid response")
+	errGrokCatalogEmpty              = errors.New("grok catalog: empty catalog")
+	errGrokCatalogInvalidModelsURL   = errors.New("grok catalog: invalid models url")
+	errGrokCatalogInvalidObservation = errors.New("grok catalog: invalid observation")
+)
+
+type GrokCatalogScope struct {
+	AccountID   int64  `json:"account_id"`
+	AccountType string `json:"account_type"`
+	Endpoint    string `json:"endpoint"`
+	Fingerprint string `json:"fingerprint"`
+}
+
+type GrokCatalogAttempt struct {
+	StartedAt  string            `json:"started_at"`
+	FinishedAt string            `json:"finished_at"`
+	Status     string            `json:"status"`
+	ErrorCode  string            `json:"error_code,omitempty"`
+	Scope      *GrokCatalogScope `json:"scope,omitempty"`
+}
+
+type GrokObservedModelsSnapshot struct {
+	Models           []string            `json:"models"`
+	FetchedAt        string              `json:"fetched_at"`
+	Source           string              `json:"source,omitempty"`
+	Scope            *GrokCatalogScope   `json:"scope,omitempty"`
+	SuccessStartedAt string              `json:"success_started_at,omitempty"`
+	LastAttempt      *GrokCatalogAttempt `json:"last_attempt,omitempty"`
+}
+
+type GrokCatalogObservation struct {
+	Models  []string
+	Attempt GrokCatalogAttempt
+}
+
+func NewGrokCatalogScope(accountID int64, accountType, modelsURL string) (*GrokCatalogScope, error) {
+	parsed, err := url.Parse(modelsURL)
+	if err != nil {
+		return nil, errGrokCatalogInvalidModelsURL
+	}
+	scheme := strings.ToLower(parsed.Scheme)
+	if parsed.Hostname() == "" || (scheme != "http" && scheme != "https") {
+		return nil, errGrokCatalogInvalidModelsURL
+	}
+	endpoint := scheme + "://" + strings.ToLower(parsed.Host) + strings.TrimRight(parsed.EscapedPath(), "/")
+	canonical := endpoint
+	if parsed.RawQuery != "" {
+		canonical += "?" + parsed.RawQuery
+	}
+	return &GrokCatalogScope{
+		AccountID:   accountID,
+		AccountType: accountType,
+		Endpoint:    endpoint,
+		Fingerprint: grokCatalogFingerprint(canonical, accountID, accountType),
+	}, nil
+}
+
+func grokCatalogFingerprint(canonicalURL string, accountID int64, accountType string) string {
+	payload := canonicalURL + "\n" + strconv.FormatInt(accountID, 10) + "\n" + accountType
+	sum := sha256.Sum256([]byte(payload))
+	return hex.EncodeToString(sum[:])
+}
+
+func MergeGrokCatalogObservation(previous *GrokObservedModelsSnapshot, observation GrokCatalogObservation) (*GrokObservedModelsSnapshot, bool, error) {
+	if err := validateGrokCatalogObservation(observation); err != nil {
+		return nil, false, err
+	}
+	started, err := time.Parse(time.RFC3339Nano, observation.Attempt.StartedAt)
+	if err != nil {
+		return nil, false, errGrokCatalogInvalidObservation
+	}
+
+	next := cloneGrokObservedSnapshot(previous)
+	if next == nil {
+		next = &GrokObservedModelsSnapshot{}
+	}
+	changed := false
+	if shouldReplaceGrokCatalogAttempt(next.LastAttempt, started) {
+		next.LastAttempt = cloneGrokCatalogAttempt(&observation.Attempt)
+		changed = true
+	}
+	if observation.Attempt.Status == grokCatalogStatusSuccess && shouldReplaceGrokCatalogSuccess(next, started) {
+		applyGrokCatalogSuccess(next, observation)
+		changed = true
+	}
+	return next, changed, nil
+}
+
+func validateGrokCatalogObservation(observation GrokCatalogObservation) error {
+	switch observation.Attempt.Status {
+	case grokCatalogStatusSuccess, grokCatalogStatusFailed, grokCatalogStatusConfiguredFallback:
+	default:
+		return errGrokCatalogInvalidObservation
+	}
+	switch observation.Attempt.ErrorCode {
+	case "", "configuration", "http_error", "transport", "invalid_response", "empty_catalog", "too_large", "persistence":
+	default:
+		return errGrokCatalogInvalidObservation
+	}
+	started, err := time.Parse(time.RFC3339Nano, observation.Attempt.StartedAt)
+	if err != nil {
+		return errGrokCatalogInvalidObservation
+	}
+	finished, err := time.Parse(time.RFC3339Nano, observation.Attempt.FinishedAt)
+	if err != nil {
+		return errGrokCatalogInvalidObservation
+	}
+	if finished.Before(started) {
+		return errGrokCatalogInvalidObservation
+	}
+	if observation.Attempt.Status == grokCatalogStatusSuccess {
+		if observation.Attempt.Scope == nil || !grokCatalogHasModelID(observation.Models) {
+			return errGrokCatalogInvalidObservation
+		}
+	}
+	return nil
+}
+
+func grokCatalogHasModelID(models []string) bool {
+	for _, model := range models {
+		if strings.TrimSpace(model) != "" {
+			return true
+		}
+	}
+	return false
+}
+
+func shouldReplaceGrokCatalogAttempt(current *GrokCatalogAttempt, started time.Time) bool {
+	if current == nil {
+		return true
+	}
+	previous, err := time.Parse(time.RFC3339Nano, current.StartedAt)
+	if err != nil {
+		return true
+	}
+	return started.After(previous)
+}
+
+func shouldReplaceGrokCatalogSuccess(current *GrokObservedModelsSnapshot, started time.Time) bool {
+	if current == nil || current.SuccessStartedAt == "" {
+		return true
+	}
+	previous, err := time.Parse(time.RFC3339Nano, current.SuccessStartedAt)
+	if err != nil {
+		return true
+	}
+	return started.After(previous)
+}
+
+func applyGrokCatalogSuccess(dst *GrokObservedModelsSnapshot, observation GrokCatalogObservation) {
+	dst.Models = append([]string(nil), observation.Models...)
+	dst.FetchedAt = observation.Attempt.FinishedAt
+	dst.SuccessStartedAt = observation.Attempt.StartedAt
+	dst.Scope = cloneGrokCatalogScope(observation.Attempt.Scope)
+}
+
+func cloneGrokObservedSnapshot(src *GrokObservedModelsSnapshot) *GrokObservedModelsSnapshot {
+	if src == nil {
+		return nil
+	}
+	dst := *src
+	if src.Models != nil {
+		dst.Models = append([]string(nil), src.Models...)
+	}
+	dst.Scope = cloneGrokCatalogScope(src.Scope)
+	dst.LastAttempt = cloneGrokCatalogAttempt(src.LastAttempt)
+	return &dst
+}
+
+func cloneGrokCatalogAttempt(src *GrokCatalogAttempt) *GrokCatalogAttempt {
+	if src == nil {
+		return nil
+	}
+	dst := *src
+	dst.Scope = cloneGrokCatalogScope(src.Scope)
+	return &dst
+}
+
+func cloneGrokCatalogScope(src *GrokCatalogScope) *GrokCatalogScope {
+	if src == nil {
+		return nil
+	}
+	dst := *src
+	return &dst
+}
+
+func parseGrokCatalogModelIDs(body []byte) ([]string, error) {
+	body = bytes.TrimSpace(body)
+	if len(body) == 0 || !json.Valid(body) {
+		return nil, errGrokCatalogInvalidResponse
+	}
+
+	var raw json.RawMessage
+	if err := json.Unmarshal(body, &raw); err != nil {
+		return nil, errGrokCatalogInvalidResponse
+	}
+	raw = bytes.TrimSpace(raw)
+	if len(raw) == 0 || bytes.Equal(raw, []byte("null")) {
+		return nil, errGrokCatalogInvalidResponse
+	}
+
+	var entries []json.RawMessage
+	switch raw[0] {
+	case '[':
+		items, err := decodeGrokCatalogArray(raw)
+		if err != nil {
+			return nil, err
+		}
+		entries = items
+	case '{':
+		var obj map[string]json.RawMessage
+		if err := json.Unmarshal(raw, &obj); err != nil {
+			return nil, errGrokCatalogInvalidResponse
+		}
+		if errRaw, ok := obj["error"]; ok && !bytes.Equal(bytes.TrimSpace(errRaw), []byte("null")) {
+			return nil, errGrokCatalogInvalidResponse
+		}
+		sawCatalog := false
+		if data, ok := obj["data"]; ok {
+			sawCatalog = true
+			items, err := decodeGrokCatalogArray(data)
+			if err != nil {
+				return nil, err
+			}
+			entries = append(entries, items...)
+		}
+		if models, ok := obj["models"]; ok {
+			sawCatalog = true
+			items, err := decodeGrokCatalogArray(models)
+			if err != nil {
+				return nil, err
+			}
+			entries = append(entries, items...)
+		}
+		if !sawCatalog {
+			return nil, errGrokCatalogInvalidResponse
+		}
+	default:
+		return nil, errGrokCatalogInvalidResponse
+	}
+
+	ids, err := grokCatalogIDsFromEntries(entries)
+	if err != nil {
+		return nil, err
+	}
+	if len(ids) == 0 {
+		return nil, errGrokCatalogEmpty
+	}
+	return ids, nil
+}
+
+func decodeGrokCatalogArray(raw json.RawMessage) ([]json.RawMessage, error) {
+	raw = bytes.TrimSpace(raw)
+	if len(raw) == 0 || raw[0] != '[' {
+		return nil, errGrokCatalogInvalidResponse
+	}
+	var items []json.RawMessage
+	if err := json.Unmarshal(raw, &items); err != nil {
+		return nil, errGrokCatalogInvalidResponse
+	}
+	return items, nil
+}
+
+func grokCatalogIDsFromEntries(entries []json.RawMessage) ([]string, error) {
+	models := make([]string, 0, len(entries))
+	for _, raw := range entries {
+		raw = bytes.TrimSpace(raw)
+		if len(raw) == 0 || bytes.Equal(raw, []byte("null")) {
+			return nil, errGrokCatalogInvalidResponse
+		}
+		switch raw[0] {
+		case '"':
+			var id string
+			if err := json.Unmarshal(raw, &id); err != nil {
+				return nil, errGrokCatalogInvalidResponse
+			}
+			models = append(models, id)
+		case '{':
+			var entry upstreamModelEntry
+			if err := json.Unmarshal(raw, &entry); err != nil {
+				return nil, errGrokCatalogInvalidResponse
+			}
+			models = append(models, grokUpstreamModelEntryID(entry))
+		default:
+			return nil, errGrokCatalogInvalidResponse
+		}
+	}
+	return dedupeAndSortModelIDs(models), nil
+}
diff --git a/backend/internal/service/grok_model_catalog_store.go b/backend/internal/service/grok_model_catalog_store.go
new file mode 100644
index 000000000..6d524812c
--- /dev/null
+++ b/backend/internal/service/grok_model_catalog_store.go
@@ -0,0 +1,112 @@
+package service
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"reflect"
+
+	infraerrors "github.com/Wei-Shaw/sub2api/internal/pkg/errors"
+)
+
+var (
+	errGrokCatalogSnapshotRepositoryUnavailable = infraerrors.InternalServer(
+		"GROK_CATALOG_SNAPSHOT_REPOSITORY_UNAVAILABLE",
+		"grok model catalog snapshot repository is unavailable",
+	)
+	errGrokCatalogAccountMismatch  = errors.New("grok model catalog account mismatch")
+	errGrokCatalogConcurrentChange = errors.New("grok model catalog changed concurrently")
+)
+
+// GrokCatalogSnapshotRepository is the narrow compare-and-swap capability for one
+// observed-model snapshot. It is intentionally not part of AccountRepository.
+type GrokCatalogSnapshotRepository interface {
+	CompareAndSwapGrokObservedModels(ctx context.Context, id int64, expected, next json.RawMessage) (bool, error)
+}
+
+// PersistGrokCatalogObservation merges one observation into the account snapshot.
+// The observation is fixed for every attempt; a conflict rereads and merges again,
+// at most three times, and never falls back to an unlocked extra update.
+func PersistGrokCatalogObservation(ctx context.Context, repo AccountRepository, accountID int64, observation GrokCatalogObservation) (*GrokObservedModelsSnapshot, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	cas, err := grokCatalogSnapshotRepository(repo)
+	if err != nil {
+		return nil, err
+	}
+	if accountID <= 0 || (observation.Attempt.Scope != nil && observation.Attempt.Scope.AccountID != accountID) {
+		return nil, errGrokCatalogAccountMismatch
+	}
+
+	for attempt := 0; attempt < 3; attempt++ {
+		if err := ctx.Err(); err != nil {
+			return nil, err
+		}
+		account, err := repo.GetByID(ctx, accountID)
+		if err != nil {
+			return nil, err
+		}
+		if account == nil {
+			return nil, ErrAccountNotFound
+		}
+		if account.ID != accountID || account.Platform != PlatformGrok {
+			return nil, errGrokCatalogAccountMismatch
+		}
+		previous := parseGrokObservedModels(account.Extra)
+		next, changed, err := MergeGrokCatalogObservation(previous, observation)
+		if err != nil {
+			return nil, err
+		}
+		if !changed {
+			return next, nil
+		}
+		var current any
+		if account.Extra != nil {
+			current = account.Extra[grokObservedModelsExtraKey]
+		}
+		expectedJSON, err := json.Marshal(current)
+		if err != nil {
+			return nil, err
+		}
+		nextJSON, err := json.Marshal(next)
+		if err != nil {
+			return nil, err
+		}
+		if err := ctx.Err(); err != nil {
+			return nil, err
+		}
+		applied, err := cas.CompareAndSwapGrokObservedModels(ctx, accountID, expectedJSON, nextJSON)
+		if err != nil {
+			return nil, err
+		}
+		if applied {
+			return next, nil
+		}
+	}
+	return nil, errGrokCatalogConcurrentChange
+}
+
+func grokCatalogSnapshotRepository(repo AccountRepository) (GrokCatalogSnapshotRepository, error) {
+	if isNilGrokCatalogValue(repo) {
+		return nil, errGrokCatalogSnapshotRepositoryUnavailable
+	}
+	cas, ok := repo.(GrokCatalogSnapshotRepository)
+	if !ok || isNilGrokCatalogValue(cas) {
+		return nil, errGrokCatalogSnapshotRepositoryUnavailable
+	}
+	return cas, nil
+}
+
+func isNilGrokCatalogValue(value any) bool {
+	if value == nil {
+		return true
+	}
+	rv := reflect.ValueOf(value)
+	switch rv.Kind() {
+	case reflect.Chan, reflect.Func, reflect.Interface, reflect.Map, reflect.Pointer, reflect.Slice:
+		return rv.IsNil()
+	default:
+		return false
+	}
+}
