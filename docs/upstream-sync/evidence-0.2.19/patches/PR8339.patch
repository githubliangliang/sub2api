+				"fetched_at": "2026-10-25T12:00:00Z",
+				"models":     []any{"fresh-model"},
+			},
+			wantMetadata: map[string]any{
+				"models": map[string]any{"fresh-model": map[string]any{"id": "fresh-model"}},
