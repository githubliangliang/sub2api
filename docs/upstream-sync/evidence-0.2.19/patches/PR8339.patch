+		"",
+		fmt.Sprintf(`data: {"id":"chatcmpl_audit","object":"chat.completion.chunk","model":%q,"choices":[],"usage":{"prompt_tokens":2,"completion_tokens":1,"total_tokens":3}}`, model),
+		"",
+		"data: [DONE]",
+		"",
+	}, "\n")
+}
