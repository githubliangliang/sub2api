+			databaseModels:   failedModels,
+			databaseMetadata: freshMetadata,
+			wantModels: map[string]any{
+				"fetched_at": "2026-10-25T12:00:00Z",
+				"models":     []any{"fresh-model"},
+				"last_attempt": map[string]any{
+					"error_code":  "transport",
