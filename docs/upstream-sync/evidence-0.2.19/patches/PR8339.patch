+	return &Account{
+		ID: 25, Platform: PlatformGrok, Type: AccountTypeOAuth,
+		Credentials: map[string]any{"model_mapping": map[string]any{
+			"friendly":           "grok-4.7",
+			"grok-4.7-latest":    "grok-4.7-latest",
+			"composer-2.5":       "composer-2.5",
