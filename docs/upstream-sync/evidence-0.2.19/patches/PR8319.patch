@@ -0,0 +1,167 @@
+package admin
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"net/http"
+	"slices"
+	"strconv"
+	"strings"
+
+	"github.com/Wei-Shaw/sub2api/internal/handler/dto"
+	"github.com/Wei-Shaw/sub2api/internal/pkg/adminaccess"
+	"github.com/Wei-Shaw/sub2api/internal/pkg/pagination"
+	"github.com/Wei-Shaw/sub2api/internal/pkg/response"
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/gin-gonic/gin"
+)
+
+func scopedAdminGroupModelsDTO(g *service.Group) gin.H {
+	return gin.H{"id": g.ID, "name": g.Name, "platform": g.Platform, "model_allowlist": g.ModelAllowlist}
+}
+
+// ScopedAdminKeyGroupModels 接管分组模型接口，禁止复用可修改费率等字段的完整处理器。
+func (h *GroupHandler) ScopedAdminKeyGroupModels(c *gin.Context) {
+	p := adminaccess.FromContext(c.Request.Context())
+	if p == nil {
+		return
+	}
+	base := "/api/v1/admin/groups/:id"
+	path := c.FullPath()
+	fullRead := slices.Contains(p.Policy.GlobalPermissions, "groups.read")
+	if c.Request.Method == http.MethodGet && (path == "/api/v1/admin/groups" || path == "/api/v1/admin/groups/all") {
+		if fullRead {
+			return
+		}
+		c.Abort()
+		h.scopedAdminListGroupModels(c)
+		return
+	}
+	// 完整分组读取继续沿用原处理器的简易模式响应。
+	if fullRead && path == base && c.Request.Method == http.MethodGet && h.isSimpleMode() {
+		return
+	}
+	candidates := path == base+"/model-allowlist-candidates"
+	if !candidates && path != base {
+		return
+	}
+	c.Abort()
+	if h.rejectUnsupportedSimpleModeOperation(c, "advanced") {
+		return
+	}
+	id, err := strconv.ParseInt(c.Param("id"), 10, 64)
+	if err != nil || id < 0 || (id == 0 && !candidates) {
+		response.BadRequest(c, "分组 ID 无效")
+		return
+	}
+	if candidates && c.Request.Method == http.MethodGet && id == 0 {
+		if !slices.Contains(p.Policy.GlobalPermissions, "models.defaults.read") {
+			response.Error(c, 403, "默认模型读取未授权")
+			return
+		}
+		h.GetGroupModelAllowlistCandidates(c)
+		return
+	}
+	g, err := h.adminService.GetGroup(c.Request.Context(), id)
+	if err != nil || g == nil {
+		response.Error(c, 404, "分组不存在")
+		return
+	}
+	permission := "groups.models.read"
+	if c.Request.Method == http.MethodPut {
+		permission = "groups.models.write"
+	}
+	allowed := p.Policy.AllowsGroupConfig(permission, g.ID, g.Platform) || (c.Request.Method == http.MethodGet && fullRead)
+	if !allowed {
+		response.Error(c, 404, "分组不存在")
+		return
+	}
+	if c.Request.Method == http.MethodGet {
+		if candidates {
+			if platform := strings.TrimSpace(c.Query("platform")); platform != "" && platform != g.Platform {
+				response.BadRequest(c, "候选模型平台必须与分组一致")
+				return
+			}
+			h.GetGroupModelAllowlistCandidates(c)
+			return
+		}
+		if fullRead {
+			response.Success(c, dto.GroupFromServiceAdmin(g))
+		} else {
+			response.Success(c, scopedAdminGroupModelsDTO(g))
+		}
+		return
+	}
+	if c.Request.Method != http.MethodPut || candidates {
+		response.Error(c, 403, "此分组操作未开放给受限管理密钥")
+		return
+	}
+	c.Request.Body = http.MaxBytesReader(c.Writer, c.Request.Body, 65536)
+	var fields map[string]json.RawMessage
+	if c.ShouldBindJSON(&fields) != nil || len(fields) != 1 {
+		response.BadRequest(c, "仅支持单独提交 model_allowlist")
+		return
+	}
+	raw := fields["model_allowlist"]
+	var cfg *service.GroupModelAllowlist
+	decoder := json.NewDecoder(bytes.NewReader(raw))
+	decoder.DisallowUnknownFields()
+	if decoder.Decode(&cfg) != nil || cfg == nil {
+		response.BadRequest(c, "模型白名单格式无效")
+		return
+	}
+	api, ok := h.adminService.(interface {
+		ScopedAdminUpdateGroupModels(context.Context, int64, service.GroupModelAllowlist) (*service.Group, error)
+	})
+	if !ok {
+		response.Error(c, 503, "受限分组模型服务不可用")
+		return
+	}
+	updated, err := api.ScopedAdminUpdateGroupModels(c.Request.Context(), id, *cfg)
+	if err != nil {
+		response.ErrorFrom(c, err)
+		return
+	}
+	response.Success(c, scopedAdminGroupModelsDTO(updated))
+}
+
+func (h *GroupHandler) scopedAdminListGroupModels(c *gin.Context) {
+	if h.rejectUnsupportedSimpleModeOperation(c, "advanced") {
+		return
+	}
+	api, ok := h.adminService.(interface {
+		ScopedAdminListGroupModels(context.Context, pagination.PaginationParams, bool, string, string, string) ([]service.Group, int64, error)
+	})
+	if !ok {
+		response.Error(c, 503, "受限分组模型服务不可用")
+		return
+	}
+	page, size := response.ParsePagination(c)
+	all := strings.HasSuffix(c.FullPath(), "/all")
+	status := c.Query("status")
+	if all {
+		status = service.StatusActive
+		if c.Query("include_inactive") == "true" {
+			status = ""
+		}
+	}
+	search := strings.TrimSpace(c.Query("search"))
+	if len(search) > 100 {
+		search = search[:100]
+	}
+	groups, total, err := api.ScopedAdminListGroupModels(c.Request.Context(), pagination.PaginationParams{Page: page, PageSize: size}, all, c.Query("platform"), status, search)
+	if err != nil {
+		response.ErrorFrom(c, err)
+		return
+	}
+	out := make([]gin.H, 0, len(groups))
+	for i := range groups {
+		out = append(out, scopedAdminGroupModelsDTO(&groups[i]))
+	}
+	if all {
+		response.Success(c, out)
+	} else {
+		response.Paginated(c, out, total, page, size)
+	}
+}
diff --git a/backend/internal/handler/admin/custom_admin_key_proxies.go b/backend/internal/handler/admin/custom_admin_key_proxies.go
new file mode 100644
index 000000000..970c5b29f
--- /dev/null
+++ b/backend/internal/handler/admin/custom_admin_key_proxies.go
@@ -0,0 +1,163 @@
+package admin
+
+import (
+	"context"
+	"fmt"
+	"slices"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/Wei-Shaw/sub2api/internal/pkg/adminaccess"
+	"github.com/Wei-Shaw/sub2api/internal/pkg/response"
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/gin-gonic/gin"
+)
+
+// scopedProxyOption 显式列出可公开字段，不能复用含用户名、密码的管理 DTO。
+type scopedProxyOption struct {
+	ID        int64      `json:"id"`
+	Name      string     `json:"name"`
+	Protocol  string     `json:"protocol"`
+	Host      string     `json:"host"`
+	Port      int        `json:"port"`
+	Status    string     `json:"status"`
+	ExpiresAt *time.Time `json:"expires_at"`
+}
+
+func scopedProxyDTO(p service.Proxy) scopedProxyOption {
+	return scopedProxyOption{ID: p.ID, Name: p.Name, Protocol: p.Protocol, Host: p.Host, Port: p.Port, Status: p.Status, ExpiresAt: p.ExpiresAt}
+}
+
+// scopedAdminProxyRead 对代理读取限定数量；无分页的 /all 从全池抽样。
+func (h *ProxyHandler) scopedAdminProxyRead(c *gin.Context) bool {
+	principal := adminaccess.FromContext(c.Request.Context())
+	if principal == nil {
+		return false
+	}
+	if !slices.Contains(principal.Policy.GlobalPermissions, "proxies.read") {
+		response.Error(c, 403, "代理读取未授权")
+		return true
+	}
+	if raw := c.Param("id"); raw != "" {
+		id, err := strconv.ParseInt(raw, 10, 64)
+		if err != nil || id < 1 {
+			response.BadRequest(c, "代理 ID 无效")
+			return true
+		}
+		p, err := h.adminService.GetProxy(c.Request.Context(), id)
+		if err != nil || p == nil {
+			response.Error(c, 404, "代理不存在")
+			return true
+		}
+		response.Success(c, scopedProxyDTO(*p))
+		return true
+	}
+	page, size := 1, 50
+	for key, dest := range map[string]*int{"page": &page, "page_size": &size} {
+		if raw, ok := c.GetQuery(key); ok {
+			n, err := strconv.Atoi(raw)
+			if err != nil || n < 1 || n > 1000000 {
+				response.BadRequest(c, "分页参数必须为正整数且不超过 1000000")
+				return true
+			}
+			*dest = n
+		}
+	}
+	if size > 100 {
+		size = 100
+	}
+	var proxies []service.Proxy
+	var total int64
+	var err error
+	if raw, ok := c.Request.URL.Query()["ids"]; ok {
+		ids := []int64{}
+		for _, part := range strings.Split(strings.Join(raw, ","), ",") {
+			if strings.TrimSpace(part) == "" {
+				continue
+			}
+			id, e := strconv.ParseInt(strings.TrimSpace(part), 10, 64)
+			if e != nil || id < 1 {
+				response.BadRequest(c, "代理 ID 无效")
+				return true
+			}
+			if !slices.Contains(ids, id) {
+				ids = append(ids, id)
+			}
+			if len(ids) > 100 {
+				response.BadRequest(c, "一次最多读取 100 个已选代理")
+				return true
+			}
+		}
+		if len(ids) > 0 {
+			proxies, err = h.adminService.GetProxiesByIDs(c.Request.Context(), ids)
+		}
+		// 最多 100 个 ID 的回显按实际存在的记录分页，保留请求顺序。
+		byID := make(map[int64]service.Proxy, len(proxies))
+		for _, p := range proxies {
+			byID[p.ID] = p
+		}
+		proxies = nil
+		for _, id := range ids {
+			if p, ok := byID[id]; ok {
+				proxies = append(proxies, p)
+			}
+		}
+		total = int64(len(proxies))
+		start := (page - 1) * size
+		if start < len(proxies) {
+			proxies = proxies[start:min(start+size, len(proxies))]
+		} else {
+			proxies = nil
+		}
+	} else {
+		search := strings.TrimSpace(c.Query("search"))
+		if len(search) > 100 {
+			response.BadRequest(c, "搜索关键词不能超过 100 字节")
+			return true
+		}
+		query := c.Request.URL.Query()
+		if strings.HasSuffix(c.FullPath(), "/proxies/all") && !query.Has("page") && !query.Has("page_size") {
+			sampler, ok := h.adminService.(interface {
+				SampleProxyOptions(context.Context, string) ([]service.Proxy, int64, error)
+			})
+			if !ok {
+				response.Error(c, 503, "代理查询暂不可用")
+				return true
+			}
+			proxies, total, err = sampler.SampleProxyOptions(c.Request.Context(), search)
+			// 旧客户端重复加载时必须重新抽样，不能复用上一次缓存的候选。
+			c.Header("Cache-Control", "no-store")
+		} else {
+			proxies, total, err = scopedProxyOptions(c.Request.Context(), h.adminService, page, size, search)
+		}
+	}
+	if err != nil {
+		response.Error(c, 503, "代理查询暂不可用")
+		return true
+	}
+	out := make([]scopedProxyOption, 0, min(len(proxies), size))
+	for _, p := range proxies[:min(len(proxies), size)] {
+		out = append(out, scopedProxyDTO(p))
+	}
+	if strings.HasSuffix(c.FullPath(), "/proxies/all") {
+		c.Header("X-Total-Count", strconv.FormatInt(total, 10))
+		c.Header("X-Page", strconv.Itoa(page))
+		c.Header("X-Page-Size", strconv.Itoa(size))
+		c.Header("X-Total-Pages", strconv.FormatInt((total+int64(size)-1)/int64(size), 10))
+		response.Success(c, out)
+	} else {
+		response.Paginated(c, out, total, page, size)
+	}
+	return true
+}
+
+func scopedProxyOptions(ctx context.Context, admin service.AdminService, page, size int, search string) ([]service.Proxy, int64, error) {
+	api, ok := admin.(interface {
+		ListProxyOptions(context.Context, int, int, string) ([]service.Proxy, int64, error)
+	})
+	if !ok {
+		return nil, 0, fmt.Errorf("代理查询不可用")
+	}
+	return api.ListProxyOptions(ctx, page, size, search)
+}
