+			require.Equal(t, tc.status, w.Code, w.Body.String())
+			require.Equal(t, tc.ids, svc.calls)
+			require.NotContains(t, w.Body.String(), "SECRET")
+			if tc.status == 200 {
+				body, err := json.Marshal(svc.fields)
+				require.NoError(t, err)
