+ INSERT INTO account_groups VALUES(1,1),(1,2),(2,2),(3,1),(4,1),(6,1);
+ UPDATE accounts SET deleted_at=NOW() WHERE id=6;
+ UPDATE accounts SET credentials='{"access_token":"inside"}';`)
+	require.NoError(t, err)
