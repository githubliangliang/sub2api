+}
+func (r *scopedCodexTestRepo) Update(ctx context.Context, a *Account) error {
+	if err := r.scopedAdminWriteTestRepo.Update(ctx, a); err != nil {
+		return err
+	}
+	extra, err := json.Marshal(a.Extra)
+	if err != nil {
+		return err
+	}
