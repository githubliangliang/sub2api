+			require.NotContains(t, result.Data, "group")
+			require.NotContains(t, result.Data, "assigned_by_user")
+			if mode == "write" {
+				require.Len(t, result.Data, 1)
+			} else {
+				require.Contains(t, result.Data, "daily_usage_usd")
+			}
+		}
+	}
