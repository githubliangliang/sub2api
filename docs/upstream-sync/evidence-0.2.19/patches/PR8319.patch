+
+type scopedCodexTestRepo struct{ *scopedAdminWriteTestRepo }
+
+func (r *scopedCodexTestRepo) Create(ctx context.Context, a *Account) error {
+	if err := r.scopedAdminWriteTestRepo.Create(ctx, a); err != nil {
+		return err
+	}
