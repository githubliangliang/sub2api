+			Platform: "openai", Models: []string{"gemini-3.1-flash-lite-image"},
+			BillingMode: BillingModeImage, PerRequestPrice: testPtrFloat64(0.1),
+		}},
+	}}
+
+	out, err := newPlazaService(channels, groups, nil).ListGroups(context.Background())
