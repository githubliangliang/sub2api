+func TestRotatedClaudeTokenRecoveryRespectsAttemptBudget(t *testing.T) {
+	for _, path := range []string{"messages", "chat/completions", "responses"} {
+		t.Run(path, func(t *testing.T) {
+			synctest.Test(t, func(t *testing.T) {
+				account := &Account{ID: 71, Platform: PlatformAnthropic, Type: AccountTypeOAuth, Status: StatusActive, Schedulable: true, Concurrency: 1, Credentials: map[string]any{"access_token": "old-token", "refresh_token": "retained-refresh"}}
+				latest := *account
+				latest.Credentials = map[string]any{"access_token": "new-token", "refresh_token": "retained-refresh"}
+				repo := &rotatedClaudeTokenRepo{account: &latest}
+				calls := 0
+				upstream := &rotatedTokenHTTPUpstream{do: func(*http.Request) (*http.Response, error) {
+					calls++
+					time.Sleep(11 * time.Second)
+					return &http.Response{StatusCode: http.StatusUnauthorized, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(`{"error":{"type":"authentication_error","message":"token revoked"}}`))}, nil
+				}}
+				cfg := &config.Config{}
+				svc := &GatewayService{cfg: cfg, accountRepo: repo, httpUpstream: upstream, claudeTokenProvider: NewClaudeTokenProvider(repo, nil, nil), rateLimitService: NewRateLimitService(repo, nil, cfg, nil, nil), deferredService: &DeferredService{}}
+				c, _ := gin.CreateTestContext(httptest.NewRecorder())
+				c.Request = httptest.NewRequest(http.MethodPost, "/v1/"+path, nil)
+				body := []byte(`{"model":"claude-sonnet-4-6","max_tokens":32,"messages":[{"role":"user","content":"hello"}]}`)
+				var err error
+				switch path {
+				case "messages":
+					parsed, parseErr := ParseGatewayRequest(NewRequestBodyRef(body), PlatformAnthropic)
+					require.NoError(t, parseErr)
+					_, err = svc.Forward(context.Background(), c, account, parsed)
+				case "chat/completions":
+					_, err = svc.ForwardAsChatCompletions(context.Background(), c, account, body, nil)
+				default:
+					_, err = svc.ForwardAsResponses(context.Background(), c, account, []byte(`{"model":"claude-sonnet-4-6","input":"hello"}`), nil)
+				}
+				var failover *UpstreamFailoverError
+				require.ErrorAs(t, err, &failover)
+				require.Equal(t, 1, calls)
+				require.Equal(t, 1, repo.cooldownCalls, "retain the normal 401 policy when the attempt budget is exhausted")
+			})
+		})
+	}
+}
