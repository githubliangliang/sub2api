+func grokAuditOAuthService(upstream HTTPUpstream, account *Account) *OpenAIGatewayService {
+	repo := &mockAccountRepoForPlatform{accountsByID: map[int64]*Account{account.ID: account}}
+	return &OpenAIGatewayService{httpUpstream: upstream, accountRepo: repo, grokTokenProvider: NewGrokTokenProvider(repo, nil), cfg: rawChatCompletionsTestConfig()}
+}
