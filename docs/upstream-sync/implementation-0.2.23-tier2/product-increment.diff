+func normalizeCodexAdditionalToolsID(id string) string {
+	if len(id) != 39 || !strings.HasPrefix(id, "at_") ||
+		id[11] != '-' || id[16] != '-' || id[21] != '-' || id[26] != '-' {
+		return id
+	}
+	uuid := strings.ReplaceAll(id[3:], "-", "")
+	if len(uuid) != 32 {
+		return id
+	}
+	if _, err := hex.DecodeString(uuid); err != nil {
+		return id
+	}
+	return "at_" + uuid
+}
